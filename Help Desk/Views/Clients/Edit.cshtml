@model Client
@{
    ViewData["Title"] = Model.Id == 0 ? "Add customer" : "Edit customer";
    var acceptedRules = (Model.EmailDomains ?? "").Split(['\r', '\n', ',', ';'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
}
<div class="page-heading"><div><a asp-action="Index">← Back to customers</a><h1>@ViewData["Title"]</h1></div></div>
<form asp-action="Save" method="post" class="panel form-panel customer-edit-form" id="customerEditForm">
    <input asp-for="Id" type="hidden" />
    <input asp-for="Email" type="hidden" id="ContactEmail" />
    <input asp-for="EmailDomains" type="hidden" id="EmailDomains" />
    <div asp-validation-summary="All" class="validation"></div>
    <label asp-for="Name">Customer Name</label>
    <input asp-for="Name" maxlength="120" />
    <label asp-for="GstNumber">GST Number</label>
    <input asp-for="GstNumber" maxlength="15" minlength="15" pattern="[0-9]{2}[A-Za-z]{5}[0-9]{4}[A-Za-z][1-9A-Za-z][Zz][0-9A-Za-z]" placeholder="27ABCDE1234F1Z5" autocapitalize="characters" />
    <span asp-validation-for="GstNumber" class="validation"></span>
    <section class="customer-contact-entry" aria-labelledby="contactEmailHeading">
        <label id="contactEmailHeading">Contact Email / Domain</label>
        <div class="customer-contact-list" id="emailRuleList">
            <div class="customer-contact-row customer-contact-primary">
                <input id="primaryContactInput" type="text" value="@Model.Email" maxlength="160" placeholder="name@company.com or company.com" aria-label="Contact email or domain" required />
                <button class="customer-contact-add" type="button" id="addEmailRule" aria-label="Add another email address or domain" title="Add another email address or domain">+</button>
            </div>
            @foreach (var rule in acceptedRules) {
                <div class="customer-contact-row"><input type="text" value="@rule" maxlength="160" placeholder="name@company.com or company.com" aria-label="Additional email address or domain" /><button type="button" class="customer-contact-remove" aria-label="Remove entry" title="Remove entry">×</button></div>
            }
        </div>
        <small class="muted">Enter an email address or a domain. Each entry can create tickets for this customer.</small>
    </section>
    <label asp-for="Phone">Phone number</label>
    <input asp-for="Phone" maxlength="40" />
    <div class="form-actions"><button class="button" type="submit">Save Customer</button><a asp-action="Index">Cancel</a></div>
</form>
<script>
(() => {
    const form = document.getElementById('customerEditForm');
    const list = document.getElementById('emailRuleList');
    const primary = document.getElementById('ContactEmail');
    const primaryInput = document.getElementById('primaryContactInput');
    const hidden = document.getElementById('EmailDomains');
    const addButton = document.getElementById('addEmailRule');
    if (!form || !list || !primary || !primaryInput || !hidden || !addButton) return;

    const sync = () => {
        primary.value = primaryInput.value.trim();
        hidden.value = Array.from(list.querySelectorAll('.customer-contact-row:not(.customer-contact-primary) input'))
            .map(input => input.value.trim()).filter(Boolean).join('\n');
    };
    addButton.addEventListener('click', () => {
        const row = document.createElement('div');
        row.className = 'customer-contact-row';
        row.innerHTML = '<input type="text" maxlength="160" placeholder="name@company.com or company.com" aria-label="Additional email address or domain"><button type="button" class="customer-contact-remove" aria-label="Remove entry" title="Remove entry">×</button>';
        list.append(row);
        row.querySelector('input').focus();
    });
    list.addEventListener('click', event => {
        const remove = event.target.closest('.customer-contact-remove');
        if (remove) { remove.closest('.customer-contact-row').remove(); sync(); }
    });
    list.addEventListener('input', sync);
    form.addEventListener('submit', sync);
    sync();
})();
</script>
