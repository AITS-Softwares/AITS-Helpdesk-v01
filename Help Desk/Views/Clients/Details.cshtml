@model DeskData
@{ int id = ViewBag.ClientId; var client = Model.Clients.Single(c => c.Id == id); ViewData["Title"] = client.Name; }
<div class="page-heading"><div><a asp-action="Index">← Back to companies</a><p class="eyebrow">AITS / CLIENT COMPANY</p><h1>@client.Name</h1><p class="muted">@client.Email · @client.Phone</p></div>@if (User.IsInRole("Admin")) { <a class="button" asp-action="Edit" asp-route-id="@id">Edit company</a> }</div>
<div class="stats"><div class="stat"><span>Client users</span><strong>@Model.Users.Count(u => u.ClientId == id)</strong>@if (User.IsInRole("Admin")) { <a asp-controller="Users" asp-action="Create" asp-route-clientId="@id">+ Add user</a> }</div><div class="stat"><span>Client tickets</span><strong>@Model.Tickets.Count(t => t.ClientId == id)</strong><a asp-controller="Tickets" asp-action="Create" asp-route-clientId="@id">+ New ticket</a></div></div>
<section class="panel"><div class="panel-heading"><h2>Client users</h2>@if (User.IsInRole("Admin")) { <a asp-controller="Users" asp-action="Index" asp-route-clientId="@id">View directory →</a> }</div><div class="table-scroll"><table><thead><tr><th>Name</th><th>Email</th><th>Department</th></tr></thead><tbody>@foreach (var user in Model.Users.Where(u => u.ClientId == id)) { <tr><td>@user.Name</td><td>@user.Email</td><td>@user.Department</td></tr> }</tbody></table></div></section>
<section class="panel" style="margin-top:24px"><div class="panel-heading"><h2>Client tickets</h2><a asp-controller="Tickets" asp-action="Index" asp-route-clientId="@id">View tickets →</a></div>@foreach(var ticket in Model.Tickets.Where(t => t.ClientId == id).OrderByDescending(t => t.UpdatedAt)) { <a class="ticket-row" asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id"><span>#@ticket.Id</span><strong class="ticket-summary">@ticket.Title</strong><span class="badge @ticket.Status">@ticket.Status</span></a> }</section>
