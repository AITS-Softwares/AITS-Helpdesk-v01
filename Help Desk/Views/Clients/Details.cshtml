@model DeskData
@{
    int id = ViewBag.ClientId;
    var client = Model.Clients.Single(c => c.Id == id);
    var projects = (List<CompanyProject>)ViewBag.Projects;
    var users = Model.Users.Where(u => u.ClientId == id).ToList();
    var tickets = Model.Tickets.Where(t => t.ClientId == id).OrderByDescending(t => t.UpdatedAt).ToList();
    var canManage = User.IsInRole("Admin") || User.IsInRole("AitsUser");
    ViewData["Title"] = client.Name;
}
<div class="company-details">
    <a class="company-back" asp-action="Index">← Back to companies</a>
    <header class="company-hero">
        <div class="company-monogram" aria-hidden="true">@(string.Concat(client.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0])).ToUpperInvariant())</div>
        <div class="company-identity"><p class="eyebrow">COMPANY WORKSPACE</p><h1>@client.Name</h1><div class="company-contact"><span>✉ @client.Email</span><span>☎ @client.Phone</span></div></div>
        @if (canManage) { <a class="button button-secondary" asp-action="Edit" asp-route-id="@id">Edit company ↗</a> }
    </header>
    <div class="company-metrics">
        <a href="#projects"><span class="company-metric-icon" aria-hidden="true">▦</span><div><strong>@projects.Count</strong><span>Company projects</span></div><span class="metric-arrow" aria-hidden="true">↗</span></a>
        <a href="#company-users"><span class="company-metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="9" cy="8" r="3"/><path d="M3 20v-3a6 6 0 0 1 12 0v3M16 5a3 3 0 0 1 0 6M18 14a5 5 0 0 1 3 4v2"/></svg></span><div><strong>@users.Count</strong><span>Client users</span></div><span class="metric-arrow" aria-hidden="true">↗</span></a>
        <a href="#company-tickets"><span class="company-metric-icon" aria-hidden="true">▤</span><div><strong>@tickets.Count</strong><span>Support tickets</span></div><span class="metric-arrow" aria-hidden="true">↗</span></a>
    </div>
    <section id="projects" class="panel company-projects">
        <div class="panel-heading"><div><p class="eyebrow">ORGANIZE &amp; COLLABORATE</p><h2>Projects <span class="count">@projects.Count</span></h2><p>Manage projects and connect each one with the right support team.</p></div>@if (canManage) { <a class="button" href="#projectName">+ New project</a> }</div>
        <div class="company-project-grid">
        @foreach (var project in projects) {
            <article class="company-project-card">
                <div class="company-project-top"><span class="company-project-symbol" aria-hidden="true">▦</span><span class="company-project-label">PROJECT</span></div>
                <h3><a asp-action="Project" asp-route-id="@project.Id">@project.Name</a></h3>
                <p>Support team assignments</p>
                <div class="company-levels"><span>L1</span><span>L2</span><span>L3</span><small>Support levels</small></div>
                <div class="company-project-actions"><a asp-action="Project" asp-route-id="@project.Id">Manage team <span aria-hidden="true">→</span></a>
                @if (canManage) { <form asp-action="RemoveProject" method="post"><input type="hidden" name="id" value="@project.Id" /><button type="submit" class="company-remove" aria-label="Remove project @project.Name">Remove</button></form> }
                </div>
            </article>
        }
        @if (projects.Count == 0) { <p class="company-empty">No projects yet. Add your first project to organize this company's support.</p> }
        </div>
        @if (canManage) {
            <form asp-action="AddProject" method="post" class="company-add-project"><input type="hidden" name="clientId" value="@id" /><div><label for="projectName">Add a new project</label><p>Create a dedicated space for your next project.</p></div><div class="company-add-controls"><input id="projectName" name="name" required maxlength="120" placeholder="e.g. Vendor Portal" /><button class="button" type="submit">+ Add project</button></div></form>
        }
    </section>
    <section id="company-users" class="panel company-directory"><div class="panel-heading"><div><h2>Client users <span class="count">@users.Count</span></h2><p>The people connected to this company.</p></div>@if (canManage) { <div class="company-directory-actions"><a asp-controller="Users" asp-action="ClientUsers" asp-route-clientId="@id">View directory →</a><a class="button button-secondary" asp-controller="Users" asp-action="Create" asp-route-clientId="@id">+ Add user</a></div> }</div><div class="table-scroll"><table><thead><tr><th>Name</th><th>Email</th><th>Department</th></tr></thead><tbody>@foreach (var user in users) { <tr><td><strong>@user.Name</strong></td><td>@user.Email</td><td>@user.Department</td></tr> }@if (users.Count == 0) { <tr><td colspan="3">No client users added yet.</td></tr> }</tbody></table></div></section>
    <section id="company-tickets" class="panel company-directory"><div class="panel-heading"><div><h2>Client tickets <span class="count">@tickets.Count</span></h2><p>Latest support activity for this company.</p></div><div class="company-directory-actions"><a asp-controller="Tickets" asp-action="Index" asp-route-clientId="@id">View tickets →</a><a class="button button-secondary" asp-controller="Tickets" asp-action="Create" asp-route-clientId="@id">+ New ticket</a></div></div>@foreach (var ticket in tickets) { <a class="ticket-row" asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id"><span>#@ticket.Id</span><strong class="ticket-summary">@ticket.Title</strong><span class="badge @ticket.Status">@ticket.Status</span></a> }@if (tickets.Count == 0) { <p class="company-empty">No tickets yet. New support requests will appear here.</p> }</section>
</div>

