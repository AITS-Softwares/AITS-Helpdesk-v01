@model DeskData
@{ var id = (int)ViewBag.ClientId; var customer = Model.Clients.Single(c => c.Id == id); var tickets = Model.Tickets.Where(t => t.ClientId == id).OrderByDescending(t => t.UpdatedAt).ToList(); var domains = (customer.EmailDomains ?? "").Split(['\r', '\n', ',', ';'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries); ViewData["Title"] = customer.Name; }
<div class="company-details"><a class="company-back" asp-action="Index">← Back to customers</a><header class="company-hero"><div class="company-monogram" aria-hidden="true">@(string.Concat(customer.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0])).ToUpperInvariant())</div><div class="company-identity"><p class="eyebrow">CUSTOMER</p><h1>@customer.Name</h1><div class="company-contact"><span>✉ @customer.Email</span><span>☎ @customer.Phone</span></div></div>@if (User.IsInRole("Admin")) { <a class="button button-secondary action-control" asp-action="Edit" asp-route-id="@id"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg><span>Edit customer</span></a> }</header>
<div class="company-metrics"><a href="#company-email-domains"><span class="company-metric-icon" aria-hidden="true">✉</span><div><strong>@domains.Length</strong><span>Accepted email rules</span></div></a><a href="#company-tickets"><span class="company-metric-icon" aria-hidden="true">▤</span><div><strong>@tickets.Count</strong><span>Support tickets</span></div></a></div>
<section id="company-email-domains" class="panel company-directory"><div class="panel-heading"><div><h2>Accepted email addresses and domains</h2><p>Incoming requests from these addresses or domains create customer tickets automatically.</p></div></div>@if (domains.Length == 0) { <p class="company-empty">No extra email rules configured. The contact email's domain is accepted.</p> } else { <ul>@foreach (var domain in domains) { <li>@domain</li> }</ul> }</section>
<section id="company-tickets" class="panel company-directory"><div class="panel-heading"><div><h2>Customer tickets <span class="count">@tickets.Count</span></h2><p>Latest support activity for this customer.</p></div><div class="company-directory-actions"><a asp-controller="Tickets" asp-action="Index" asp-route-clientId="@id">View tickets →</a><a class="button button-secondary" asp-controller="Tickets" asp-action="Create" asp-route-clientId="@id">+ New ticket</a></div></div>@foreach (var ticket in tickets) { <a class="ticket-row" asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id"><span>#@ticket.Id</span><strong class="ticket-summary">@ticket.Title</strong><span class="badge @ticket.Status">@ticket.Status</span></a> }@if (tickets.Count == 0) { <p class="company-empty">No tickets yet.</p> }</section></div>
