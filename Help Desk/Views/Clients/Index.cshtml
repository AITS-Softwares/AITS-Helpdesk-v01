@model DeskData
@{ ViewData["Title"] = "Companies"; }
<div class="page-heading"><div><p class="eyebrow">AITS COMPANY MANAGEMENT</p><h1>Companies <span class="count">@Model.Clients.Count</span></h1><p class="muted">Manage each client's people and support requests.</p></div>@if (User.IsInRole("Admin")) { <a class="button" asp-action="Create">+ Add company</a> }</div>
<section class="panel"><div class="table-scroll"><table><thead><tr><th>Company</th><th>Contact email</th><th>Users</th><th>Tickets</th><th></th></tr></thead><tbody>@foreach (var client in Model.Clients) { <tr><td><a asp-action="Details" asp-route-id="@client.Id"><strong>@client.Name</strong></a></td><td>@client.Email</td><td>@Model.Users.Count(u => u.ClientId == client.Id)</td><td>@Model.Tickets.Count(t => t.ClientId == client.Id)</td><td>@if (User.IsInRole("Admin")) { <a asp-action="Edit" asp-route-id="@client.Id">Edit →</a><span> · </span><a asp-action="Delete" asp-route-id="@client.Id">Delete</a> }</td></tr> }</tbody></table></div>@if (!Model.Clients.Any()) { <div class="empty">Add your first client company.</div> }</section>
