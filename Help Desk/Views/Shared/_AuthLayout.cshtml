<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] · AITS</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head><body class="auth-body"><div class="auth-wrap"><a class="brand" asp-controller="Account" asp-action="Login"><span class="brand-icon">a</span>AITS<span class="brand-dot">.</span></a><div class="auth-intro"><p class="eyebrow">CLIENT SUPPORT WORKSPACE</p><h1>Good support starts here.</h1><p class="muted">Your people, companies, and requests. Connected.</p></div><main class="auth-card">@if (TempData["Message"] is string message) { <div class="notice" role="status">@message</div> }@RenderBody()</main><p class="auth-footer">AITS Helpdesk · Built around your team</p></div>@await RenderSectionAsync("Scripts", required: false)</body></html>
