@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var staffSection = ViewData["StaffSection"] as bool? ?? (action == "AitsStaff" || Context.Request.Query["staff"].ToString().Equals("true", StringComparison.OrdinalIgnoreCase));
    var internalUser = User.IsInRole("Admin");
    var displayName = User.Identity?.Name ?? "Your workspace";
    var initials = string.Concat(displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[0])).ToUpperInvariant();
    var roleLabel = User.IsInRole("Admin") ? "Administrator" : User.IsInRole("AitsUser") ? "Agents" : "Customer user";
}
<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#171e32" /><title>@ViewData["Title"] · AITS Helpdesk</title><script>try{if(localStorage.getItem('helpdesk-theme')==='dark')document.documentElement.dataset.theme='dark'}catch{}</script><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" /></head>
<body>
<a class="skip-link" href="#main-content">Skip to content</a>
<aside class="sidebar"><div class="sidebar-brand">
    <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-icon">a</span><span>AITS<span class="brand-dot">.</span><small>SUPPORT WORKSPACE</small></span></a>
    <button type="button" id="navigation-toggle" class="menu-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="workspace-navigation"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg> Menu</button></div>
    <p class="nav-label">WORKSPACE</p>
    <nav id="workspace-navigation" aria-label="Main navigation">
        <a class="@(controller == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index"><span class="nav-icon">◈</span> Overview</a>
        <a class="@(controller == "Tickets" ? "active" : "")" asp-controller="Tickets" asp-action="Index"><span class="nav-icon">▤</span> Tickets</a>
        @if (User.IsInRole("AitsUser")) { <a class="@(controller == "MyWork" && action != "ClientUsers" ? "active" : "")" asp-controller="MyWork" asp-action="Index"><span class="nav-icon">▦</span> My customers</a><a class="@(controller == "MyWork" && action == "ClientUsers" ? "active" : "")" asp-controller="MyWork" asp-action="ClientUsers"><span class="nav-icon">◉</span> Customer users</a> }
        @if (internalUser) {
            <a class="@(controller == "Clients" ? "active" : "")" asp-controller="Clients" asp-action="Index"><span class="nav-icon">▦</span> Customers</a>
            <span class="nav-label nav-section">PEOPLE &amp; ACCESS</span>
            <a class="@((controller == "Account" || controller == "Users") ? "active" : "")" asp-controller="Account" asp-action="Index"><span class="nav-icon">◇</span> Sign-in accounts</a>
            <a class="@(controller == "TatSettings" ? "active" : "")" asp-controller="TatSettings" asp-action="Index"><span class="nav-icon">◷</span> TAT settings</a>
            <a class="@(controller == "EmailSettings" ? "active" : "")" asp-controller="EmailSettings" asp-action="Index"><span class="nav-icon">✉</span> Email settings</a>
        }
    </nav>
    <div class="sidebar-note"><span class="sidebar-note-icon">✦</span><strong>Support, in sync.</strong><p>The right agents. The right customers. A clearer way to work.</p></div>
    <div class="sidebar-footer"><div class="workspace"><span class="avatar">@initials</span><span class="workspace-person">@displayName<small>@roleLabel</small></span></div><form asp-controller="Account" asp-action="Logout" method="post" class="signout-form"><button type="submit">Sign out <span aria-hidden="true">↗</span></button></form></div>
</aside>
<div class="shell">
    <header class="topbar"><div class="breadcrumb"><span class="breadcrumb-icon">▦</span><span>Workspace</span><span class="breadcrumb-divider">/</span><strong>@ViewData["Title"]</strong></div><div class="topbar-actions"><button type="button" id="theme-toggle" class="theme-toggle" aria-label="Switch to dark theme" aria-pressed="false"><span aria-hidden="true">☾</span><span class="theme-toggle-label">Dark mode</span></button><span class="workspace-badge"><span class="status-dot"></span>@roleLabel</span></div></header>
    <main id="main-content">@if (TempData["Message"] is string message) { <div class="notice" role="status"><span aria-hidden="true">✓</span> @message</div> }@if (TempData["Error"] is string error) { <div class="error notice" role="alert">@error</div> }@if (User.IsInRole("Admin") || User.IsInRole("AitsUser")) { @await Component.InvokeAsync("TatAlerts") }@RenderBody()</main>
    <footer><span>AITS Helpdesk <span class="footer-dot">·</span> Connected support, better work.</span><span>All timestamps in UTC</span></footer>
</div>
<dialog class="confirm-dialog" id="delete-confirm-dialog" aria-labelledby="delete-confirm-title" aria-describedby="delete-confirm-message">
    <form method="dialog" class="confirm-dialog-card">
        <span class="confirm-dialog-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2m3 0-1 14H6L5 6m4 4v6m6-6v6"/></svg></span>
        <h2 id="delete-confirm-title">Confirm deletion</h2>
        <p id="delete-confirm-message">Are you sure you want to delete this item?</p>
        <div class="confirm-dialog-actions"><button type="submit" value="cancel" class="button button-secondary" data-confirm-cancel>Cancel</button><button type="submit" value="confirm" class="button danger" data-confirm-accept>Delete</button></div>
    </form>
</dialog>
<script src="~/js/responsive.js" asp-append-version="true" defer></script>
<script src="~/js/theme.js" asp-append-version="true" defer></script>
<script src="~/js/tat.js" asp-append-version="true" defer></script>
<script src="~/js/site.js" asp-append-version="true" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
