<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] · AITS Helpdesk</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body><aside class="sidebar"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-icon">a</span> AITS<span class="brand-dot">.</span></a><p class="nav-label">WORKSPACE</p><nav><a asp-controller="Home" asp-action="Index">◈ &nbsp; Overview</a><a asp-controller="Tickets" asp-action="Index">▤ &nbsp; Tickets</a>@if (User.IsInRole("Admin") || User.IsInRole("AitsUser")) { <a asp-controller="Clients" asp-action="Index">▦ &nbsp; Companies</a> }@if (User.IsInRole("Admin")) { <a asp-controller="Users" asp-action="Index">◉ &nbsp; Users</a><a asp-controller="Account" asp-action="Index">◇ &nbsp; Sign-in accounts</a> }</nav><div class="sidebar-note"><strong>A little support goes a long way.</strong><p>One workspace for every request.</p></div><div class="workspace"><span>@User.Identity?.Name<br /><small>@User.FindFirst("role")?.Value</small></span></div><form asp-controller="Account" asp-action="Logout" method="post" class="signout-form"><button type="submit">Sign out →</button></form></aside>
<div class="shell"><header class="topbar"><span>Workspace <span class="muted">/ @ViewData["Title"]</span></span><span class="workspace-badge">● &nbsp; @User.FindFirst("role")?.Value</span></header><main>@if (TempData["Message"] is string message) { <div class="notice" role="status">@message</div> } @if (TempData["Error"] is string error) { <div class="error notice" role="alert">@error</div> } @RenderBody()</main><footer>AITS Helpdesk · Make work flow better <span>All timestamps in UTC</span></footer></div>@await RenderSectionAsync("Scripts", required: false)</body></html>
