@model List<CompanyProject>
@{ ViewData["Title"] = "My customers"; var customers = (List<Client>)ViewBag.Companies; }
<div class="page-heading"><div><h1>My customers</h1><p class="muted">Customers assigned to your agent account.</p></div></div>
<section class="panel detail-panel"><div class="project-card-grid">@foreach (var customer in customers) { <a class="project-card" asp-controller="Tickets" asp-action="Index" asp-route-clientId="@customer.Id"><strong>@customer.Name</strong><small>View customer tickets →</small></a> }</div>@if (!customers.Any()) { <p class="empty">No customers assigned. Contact your administrator.</p> }</section>
