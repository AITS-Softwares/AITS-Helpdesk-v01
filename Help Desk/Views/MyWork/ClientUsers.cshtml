@model List<DeskUser>
@{ ViewData["Title"] = "Customer users"; int? clientId = ViewBag.CompanyId; var customers = (List<CompanyProject>)ViewBag.Projects; var enabled = (HashSet<int>)ViewBag.EnabledUserIds; }
<div class="page-heading"><div><h1>Customer users <span class="count">@Model.Count</span></h1><p class="muted">People from customers assigned to you.</p></div><a class="button" asp-action="CreateClient" asp-route-companyId="@clientId">+ Add customer user</a></div>
<section class="panel"><form method="get" class="filters"><select name="companyId" aria-label="Customer"><option value="">All assigned customers</option>@foreach (var customer in customers.Select(p => p.Client!).DistinctBy(c => c.Id)) { <option value="@customer.Id" selected="@(clientId == customer.Id)">@customer.Name</option> }</select><button class="button" type="submit">Filter</button><a asp-action="ClientUsers">Reset</a></form><div class="table-scroll"><table><thead><tr><th>Customer user</th><th>Email</th><th>Department</th><th>Customer</th><th>Sign-in</th></tr></thead><tbody>@foreach (var user in Model) { <tr><td>@user.Name</td><td>@user.Email</td><td>@user.Department</td><td>@user.Client?.Name</td><td>@if (enabled.Contains(user.Id)) { <span class="badge">Sign-in enabled</span> } else { <a asp-controller="Account" asp-action="Create" asp-route-userId="@user.Id">Enable sign-in</a> }</td></tr> }</tbody></table></div>@if (!Model.Any()) { <p class="empty">No customer users found for your assigned customers.</p> }</section>
