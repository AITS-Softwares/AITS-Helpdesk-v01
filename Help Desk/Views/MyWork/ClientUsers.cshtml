@model List<ClientDeskUser>
@{ ViewData["Title"] = "Client users"; var projects = (List<CompanyProject>)ViewBag.Projects; int? companyId = ViewBag.CompanyId; var enabled = (HashSet<int>)ViewBag.EnabledUserIds; }
<div class="page-heading"><div><h1>Client users <span class="count">@Model.Count</span></h1><p class="muted">Client contacts from companies where you have assigned projects. Client users belong to a company; the project column shows your assigned projects for that company.</p></div><a class="button" asp-action="CreateClient" asp-route-companyId="@companyId">+ Add client user</a></div>
<section class="panel"><form method="get" class="filters"><select name="companyId" aria-label="Company"><option value="">All assigned companies</option>@foreach (var company in projects.Select(p => p.Client!).DistinctBy(c => c.Id)) { <option value="@company.Id" selected="@(companyId == company.Id)">@company.Name</option> }</select><button class="button" type="submit">Filter</button><a asp-action="ClientUsers">Reset</a></form>
<div class="table-scroll"><table><thead><tr><th>Client user</th><th>Email</th><th>Department</th><th>Company</th><th>Your assigned projects</th><th>Sign-in</th></tr></thead><tbody>@foreach (var client in Model) { <tr><td>@client.Name</td><td>@client.Email</td><td>@client.Department</td><td>@client.Client?.Name</td><td>@foreach (var project in projects.Where(p => p.ClientId == client.ClientId)) { <div><a asp-action="Project" asp-route-id="@project.Id">@project.Name</a></div> }</td><td>@if (enabled.Contains(client.Id)) { <span class="badge">Sign-in enabled</span> } else { <a asp-controller="Account" asp-action="Create" asp-route-userId="@client.Id">Enable sign-in</a> }</td></tr> }</tbody></table></div>@if (!Model.Any()) { <p class="empty">No client users found for your assigned companies.</p> }</section>
