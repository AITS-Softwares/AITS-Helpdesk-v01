@model UserEditViewModel
@{ ViewData["Title"] = "Add client user"; }
<div class="page-heading"><div><a asp-action="ClientUsers">← Client users</a><h1>Add client user</h1><p class="muted">Create a client contact for a company where you have an assigned project.</p></div></div>
<form asp-action="CreateClient" method="post" class="panel form-panel"><div asp-validation-summary="All" class="validation"></div><label asp-for="ClientId">Company</label><select asp-for="ClientId" required><option value="">Select a company</option>@foreach (var company in (List<Client>)ViewBag.Clients) { <option value="@company.Id">@company.Name</option> }</select><label asp-for="Name">Full name</label><input asp-for="Name" maxlength="80" required /><label asp-for="Email"></label><input asp-for="Email" type="email" maxlength="160" required /><label asp-for="Department"></label><input asp-for="Department" maxlength="80" required /><div class="form-actions"><button class="button" type="submit">Create client user</button><a asp-action="ClientUsers">Cancel</a></div></form>
