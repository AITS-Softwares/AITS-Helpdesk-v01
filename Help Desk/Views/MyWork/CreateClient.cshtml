@model UserEditViewModel
@{ ViewData["Title"] = "Add customer user"; }
<div class="page-heading"><div><a asp-action="ClientUsers">← Customer users</a><h1>Add customer user</h1><p class="muted">Create a client contact for a customer where you have an assigned customer.</p></div></div>
<form asp-action="CreateClient" method="post" class="panel form-panel"><div asp-validation-summary="All" class="validation"></div><label asp-for="ClientId">Customer</label><select asp-for="ClientId" required><option value="">Select a customer</option>@foreach (var customer in (List<Client>)ViewBag.Clients) { <option value="@customer.Id">@customer.Name</option> }</select><label asp-for="Name">Full name</label><input asp-for="Name" maxlength="80" required /><label asp-for="Email"></label><input asp-for="Email" type="email" maxlength="160" required /><label asp-for="Department"></label><input asp-for="Department" maxlength="80" required /><div class="form-actions"><button class="button" type="submit">Create customer user</button><a asp-action="ClientUsers">Cancel</a></div></form>
