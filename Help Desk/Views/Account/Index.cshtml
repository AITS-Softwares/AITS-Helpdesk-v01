@model List<DeskAccount>
@{ ViewData["Title"] = "Sign-in accounts"; }
<div class="page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h1>Sign-in accounts</h1><p class="muted">Admin, AITS staff, and client access are separate.</p></div><a class="button" asp-action="Create">+ Enable user sign-in</a></div>
<section class="panel"><div class="table-scroll"><table><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Created (UTC)</th><th>Action</th></tr></thead><tbody>@foreach(var account in Model) { <tr><td>@account.Name</td><td>@account.Email</td><td><span class="badge">@account.Role</span></td><td>@(account.IsApproved ? "Approved" : "Pending approval")</td><td>@account.CreatedAt.ToString("dd MMM yyyy, HH:mm")</td><td>@if (!account.IsApproved && account.Role == AccountRole.AitsUser) { <form asp-action="Approve" method="post"><input type="hidden" name="id" value="@account.Id" /><button type="submit" class="button">Approve staff</button></form> }</td></tr> }</tbody></table></div></section>
