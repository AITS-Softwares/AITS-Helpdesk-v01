@model List<DeskAccount>
@{
    var directory = (List<DeskUser>)ViewBag.DirectoryUsers;
    var projects = (Dictionary<int, List<string>>)ViewBag.StaffProjects;
    var rows = directory
        .Select(u => new AccountDirectoryRow { User = u, Account = Model.FirstOrDefault(a => a.DeskUserId == u.Id) })
        .Concat(Model.Where(a => a.DeskUserId == null).Select(a => new AccountDirectoryRow { Account = a }))
        .OrderBy(r => r.Name)
        .ToList();
    var clients = (bool)ViewBag.ClientAccounts;
    ViewData["Title"] = clients ? "Customer sign-in accounts" : "Admin / Agent sign-in accounts";
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700&family=Figtree:wght@400;500;600&display=swap" />

<style>
    .ad-page {
        --ink: #14263a;
        --teal: #0f7b8a;
        --teal-dark: #0b5f6b;
        --tint: #e4f1f0;
        --signal: #f2b544;
        --surface: #ffffff;
        --soft: #f5f8fa;
        --text: #1b2733;
        --muted: #5b6b7a;
        --line: #d5dde4;
        --danger: #b3261e;
        font-family: "Figtree", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        color: var(--text);
        max-width: 80rem;
        margin: 0 auto;
        padding: clamp(0.75rem, 3vw, 2rem);
    }

        .ad-page *,
        .ad-page *::before,
        .ad-page *::after {
            box-sizing: border-box;
        }

    .ad-muted {
        color: var(--muted);
    }

    /* ---------- Heading ---------- */
    .ad-heading {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

        .ad-heading h1 {
            font-family: "Bricolage Grotesque", "Figtree", system-ui, sans-serif;
            font-size: clamp(1.5rem, 4vw, 2.1rem);
            line-height: 1.1;
            letter-spacing: -0.01em;
            margin: 0 0 0.35rem;
            color: var(--ink);
        }

        .ad-heading p {
            margin: 0;
            color: var(--muted);
        }

    .ad-heading-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
    }

    /* ---------- Buttons & links ---------- */
    .ad-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font: inherit;
        font-weight: 600;
        font-size: 0.92rem;
        text-decoration: none;
        color: #fff;
        background: var(--teal);
        border: 1.5px solid var(--teal);
        border-radius: 0.6rem;
        min-height: 2.6rem;
        padding: 0.5rem 1rem;
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s;
    }

        .ad-btn:hover {
            background: var(--teal-dark);
            border-color: var(--teal-dark);
            color: #fff;
        }

        .ad-btn.is-outline {
            background: transparent;
            color: var(--teal-dark);
        }

            .ad-btn.is-outline:hover {
                background: var(--tint);
                color: var(--teal-dark);
            }

        .ad-btn.is-small {
            min-height: 2.1rem;
            padding: 0.25rem 0.75rem;
            font-size: 0.85rem;
        }

        .ad-btn:focus-visible,
        .ad-link:focus-visible,
        .ad-tabs a:focus-visible,
        .ad-reset:focus-visible {
            outline: 3px solid var(--signal);
            outline-offset: 2px;
        }

    .ad-link {
        font: inherit;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--teal-dark);
        background: none;
        border: 0;
        padding: 0.3rem 0.1rem;
        cursor: pointer;
        text-decoration: none;
        text-underline-offset: 3px;
    }

        .ad-link:hover {
            text-decoration: underline;
        }

        .ad-link.is-danger {
            color: var(--danger);
        }

    /* ---------- Panels ---------- */
    .ad-panel {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 1rem;
        padding: clamp(1rem, 3vw, 1.5rem);
        margin-bottom: 1.5rem;
        box-shadow: 0 1px 2px rgba(20, 38, 58, 0.04), 0 8px 24px rgba(20, 38, 58, 0.06);
    }

    .ad-panel-head h2 {
        font-family: "Bricolage Grotesque", "Figtree", system-ui, sans-serif;
        font-size: 1.25rem;
        margin: 0 0 0.25rem;
        color: var(--ink);
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .ad-panel-head p {
        margin: 0 0 1rem;
        color: var(--muted);
        font-size: 0.92rem;
    }

    .ad-count {
        display: inline-grid;
        place-items: center;
        min-width: 1.6rem;
        height: 1.6rem;
        padding: 0 0.45rem;
        border-radius: 999px;
        background: var(--signal);
        color: var(--ink);
        font-family: "Figtree", system-ui, sans-serif;
        font-size: 0.8rem;
        font-weight: 700;
    }

    /* ---------- Tabs & filters ---------- */
    .ad-tabs {
        display: inline-flex;
        flex-wrap: wrap;
        gap: 0.25rem;
        padding: 0.25rem;
        background: var(--soft);
        border: 1px solid var(--line);
        border-radius: 0.8rem;
        margin-bottom: 1.1rem;
    }

        .ad-tabs a {
            text-decoration: none;
            color: var(--muted);
            font-weight: 600;
            font-size: 0.92rem;
            padding: 0.5rem 0.9rem;
            border-radius: 0.6rem;
        }

            .ad-tabs a:hover {
                color: var(--ink);
            }

            .ad-tabs a.is-active {
                background: var(--teal);
                color: #fff;
            }

    .ad-filters {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 1.1rem;
    }

        .ad-filters select {
            font: inherit;
            color: var(--text);
            background: #fff;
            border: 1.5px solid var(--line);
            border-radius: 0.6rem;
            min-height: 2.6rem;
            padding: 0.4rem 0.8rem;
            min-width: min(100%, 16rem);
        }

            .ad-filters select:focus-visible {
                outline: none;
                border-color: var(--teal);
                box-shadow: 0 0 0 3px rgba(15, 123, 138, 0.22);
            }

    .ad-reset {
        color: var(--teal-dark);
        font-weight: 600;
        font-size: 0.9rem;
        text-underline-offset: 3px;
    }

    /* ---------- Table ---------- */
    .ad-scroll {
        overflow-x: auto;
        border: 1px solid var(--line);
        border-radius: 0.8rem;
    }

    .ad-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        font-size: 0.92rem;
    }

        .account-directory-table th:nth-child(1) { width: 18%; }
        .account-directory-table th:nth-child(2) { width: 23%; }
        .account-directory-table th:nth-child(3) { width: 17%; }
        .account-directory-table th:nth-child(4) { width: 11%; }
        .account-directory-table th:nth-child(5) { width: 12%; }
        .account-directory-table th:nth-child(6) { width: 19%; }

        .ad-table th {
            text-align: left;
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--muted);
            background: var(--soft);
            padding: 0.7rem 0.9rem;
            white-space: nowrap;
            border-bottom: 1px solid var(--line);
        }

        .ad-table td {
            padding: 0.8rem 0.9rem;
            vertical-align: top;
            border-bottom: 1px solid var(--line);
        }

        .ad-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .ad-table tbody tr:hover {
            background: #fafcfd;
        }

    .ad-person {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        min-width: 0;
    }

    .ad-avatar {
        flex: none;
        width: 2.2rem;
        height: 2.2rem;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: var(--tint);
        color: var(--teal-dark);
        font-weight: 700;
        font-size: 0.9rem;
    }

    .ad-person strong {
        color: var(--ink);
        overflow-wrap: anywhere;
    }

    .ad-email {
        overflow-wrap: anywhere;
    }

    .ad-chip {
        display: inline-block;
        background: var(--soft);
        border: 1px solid var(--line);
        border-radius: 0.4rem;
        padding: 0.1rem 0.5rem;
        margin: 0 0.3rem 0.3rem 0;
        font-size: 0.82rem;
    }

    .ad-badge {
        display: inline-block;
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 600;
        background: var(--tint);
        color: var(--teal-dark);
        white-space: nowrap;
    }

        .ad-badge.is-ok,
        .ad-badge.is-active {
            background: #e1f4e8;
            color: #1d6b3a;
        }

        .ad-badge.is-pending {
            background: #fdf1d6;
            color: #8a5a00;
        }

        .ad-badge.is-inactive {
            background: #eceff2;
            color: var(--muted);
        }

    .ad-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.35rem;
    }

        .ad-actions form {
            margin: 0;
            display: inline-flex;
        }

    .ad-empty {
        margin: 0;
        padding: 1.5rem 1rem;
        text-align: center;
        color: var(--muted);
        background: var(--soft);
        border: 1px dashed var(--line);
        border-radius: 0.8rem;
    }

    /* ---------- Responsive: table becomes cards ---------- */
    @@media (max-width: 64rem) {
        .ad-scroll {
            border: 0;
            overflow: visible;
        }

        .ad-table,
        .ad-table tbody,
        .ad-table tr,
        .ad-table td {
            display: block;
            width: 100%;
        }

            .ad-table thead {
                position: absolute;
                width: 1px;
                height: 1px;
                overflow: hidden;
                clip: rect(0 0 0 0);
            }

            .ad-table tbody tr {
                border: 1px solid var(--line);
                border-radius: 0.8rem;
                margin-bottom: 0.9rem;
                padding: 0.4rem 0.9rem 0.6rem;
                background: #fff;
            }

                .ad-table tbody tr:hover {
                    background: #fff;
                }

            .ad-table td {
                display: grid;
                grid-template-columns: 8.5rem 1fr;
                gap: 0.6rem;
                padding: 0.55rem 0;
                border-bottom: 1px solid var(--soft);
            }

                .ad-table td::before {
                    content: attr(data-label);
                    font-size: 0.82rem;
                    font-weight: 600;
                    color: var(--muted);
                }

                .ad-table td:first-child {
                    grid-template-columns: 1fr;
                    padding-top: 0.7rem;
                }

                    .ad-table td:first-child::before {
                        display: none;
                    }

                .ad-table td.ad-cell-actions {
                    grid-template-columns: 1fr;
                    border-bottom: 0;
                    padding-bottom: 0.2rem;
                }

                    .ad-table td.ad-cell-actions::before {
                        display: none;
                    }
    }

    @@media (max-width: 30rem) {
        .ad-heading-actions,
        .ad-heading-actions .ad-btn {
            width: 100%;
        }

        .ad-tabs {
            display: flex;
            width: 100%;
        }

            .ad-tabs a {
                flex: 1 1 auto;
                text-align: center;
            }

        .ad-table td {
            grid-template-columns: 1fr;
            gap: 0.15rem;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .ad-page * {
            transition: none !important;
        }
    }
</style>

<div class="ad-page">

    <div class="ad-heading">
        <div>
            <h1>@ViewData["Title"]</h1>
            <p>Administrators, agents, and customer access are separate.</p>
        </div>
        @if (!clients)
        {
            <div class="ad-heading-actions">
                <a class="ad-btn" asp-action="CreateAdmin">+ Add administrator</a>
                <a class="ad-btn is-outline" asp-controller="Users" asp-action="Create" asp-route-staff="true">+ Add agent</a>
            </div>
        }
    </div>

    @if (User.IsInRole("Admin"))
    {
        var requests = (List<PasswordResetRequestItem>)ViewBag.PasswordResetRequests;
        <section class="ad-panel">
            <div class="ad-panel-head">
                <h2>Password reset requests <span class="ad-count">@requests.Count</span></h2>
                <p>Verify the user before resetting their password. No reset emails are sent.</p>
            </div>

            @if (requests.Any())
            {
                <div class="ad-scroll">
                    <table class="ad-table">
                        <thead>
                            <tr><th>Email</th><th>Requested (UTC)</th><th>Action</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var request in requests)
                            {
                                <tr>
                                    <td data-label="Email"><span class="ad-email">@request.Email</span></td>
                                    <td data-label="Requested (UTC)">@request.RequestedAt.ToString("dd MMM yyyy, HH:mm")</td>
                                    <td class="ad-cell-actions" data-label="Action">
                                        <div class="ad-actions">
                                            @if (request.AccountId.HasValue)
                                            {
                                                <a class="ad-btn is-small" asp-action="ResetPassword" asp-route-id="@request.AccountId">Reset password</a>
                                            }
                                            else
                                            {
                                                <span class="ad-muted">Account no longer available</span>
                                            }
                                            <form asp-action="DismissResetRequest" method="post">
                                                <input type="hidden" name="id" value="@request.RequestId" />
                                                <button type="submit" class="ad-link">Dismiss</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="ad-empty">No pending password reset requests.</p>
            }
        </section>
    }

    <section class="ad-panel">
        <nav class="ad-tabs" aria-label="Sign-in account groups">
            <a asp-action="Index" class="@(!clients ? "is-active" : "")" aria-current="@(!clients ? "page" : null)">Admin / Agent accounts</a>
            <a asp-action="Index" asp-route-clients="true" class="@(clients ? "is-active" : "")" aria-current="@(clients ? "page" : null)">Customer accounts</a>
        </nav>

        @if (clients)
        {
            <form method="get" class="ad-filters">
                <input type="hidden" name="clients" value="true" />
                <select name="clientId" aria-label="Customer">
                    <option value="">All customers</option>
                    @foreach (var customer in (List<Client>)ViewBag.Companies)
                    {
                        <option value="@customer.Id" selected="@(ViewBag.ClientId == customer.Id)">@customer.Name</option>
                    }
                </select>
                <button type="submit" class="ad-btn">Filter</button>
                <a class="ad-reset" asp-action="Index" asp-route-clients="true">Reset</a>
            </form>
        }

        <div class="ad-scroll">
            <table class="ad-table account-directory-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>@(clients ? "Customer" : "Assigned customers")</th>
                        <th>Approval</th>
                        <th>Access</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in rows)
                    {
                        var account = row.Account;
                        var user = row.User;
                        var active = account is not null && account.IsActive && user is not AitsStaffUser { IsActive: false };
                        var initial = string.IsNullOrWhiteSpace(row.Name) ? "?" : row.Name.Trim().Substring(0, 1).ToUpper();

                        <tr>
                            <td data-label="Name">
                                <div class="ad-person">
                                    <span class="ad-avatar" aria-hidden="true">@initial</span>
                                    <strong>@row.Name</strong>
                                </div>
                            </td>

                            <td data-label="Email"><span class="ad-email">@(user?.Email ?? account?.Email)</span></td>

                            <td data-label="@(clients ? "Customer" : "Assigned customers")">
                                @if (clients)
                                {
                                    @user?.Client?.Name
                                }
                                else if (user is not null && projects.TryGetValue(user.Id, out var assignments))
                                {
                                    @foreach (var project in assignments)
                                    {
                                        <span class="ad-chip">@project</span>
                                    }
                                }
                                else
                                {
                                    <span class="ad-muted">@(user is null ? "Administrator" : "No customers assigned")</span>
                                }
                            </td>

                            <td data-label="Approval">
                                @if (account is null)
                                {
                                    <span class="ad-muted">—</span>
                                }
                                else if (account.IsApproved)
                                {
                                    <span class="ad-badge is-ok">Approved</span>
                                }
                                else
                                {
                                    <span class="ad-badge is-pending">Pending approval</span>
                                }
                            </td>

                            <td data-label="Access">
                                <span class="ad-badge @(active ? "is-active" : "is-inactive")">@(account is null ? "Sign-in not enabled" : active ? "Active" : "Inactive")</span>
                            </td>

                            <td class="ad-cell-actions" data-label="Actions">
                                <div class="ad-actions">
                                    @if (user is not null)
                                    {
                                        <a class="ad-link action-control" asp-controller="Users" asp-action="Edit" asp-route-id="@user.Id"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg><span>Edit</span></a>
                                        <form asp-controller="Users" asp-action="Delete" method="post" class="inline-delete-form" data-confirm-delete data-confirm-title="Delete user?" data-confirm-message="Delete @user.Name? This cannot be undone. Users referenced by tickets cannot be deleted.">
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button class="ad-link is-danger action-control" type="submit"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2m3 0-1 14H6L5 6m4 4v6m6-6v6"/></svg><span>Delete</span></button>
                                        </form>
                                        @if (user is AitsStaffUser)
                                        {
                                            <a class="ad-link" asp-controller="Users" asp-action="AssignCustomers" asp-route-id="@user.Id">Assign customers</a>
                                        }
                                    }

                                    @if (account is null && user is not null)
                                    {
                                        <a class="ad-link" asp-action="Create" asp-route-userId="@user.Id">Enable sign-in</a>
                                    }

                                    @if (account is not null)
                                    {
                                        <a class="ad-link" asp-action="ResetPassword" asp-route-id="@account.Id">Reset password</a>

                                        @if (account.Role != AccountRole.Admin)
                                        {
                                            <form asp-action="SetActive" method="post">
                                                @if (user is AitsStaffUser)
                                                {
                                                    <input type="hidden" name="staffId" value="@user.Id" />
                                                }
                                                <input type="hidden" name="id" value="@account.Id" />
                                                <input type="hidden" name="isActive" value="@(active ? "false" : "true")" />
                                                <button type="submit" class="ad-link @(active ? "is-danger" : "")">@(active ? "Disable sign-in" : "Enable sign-in")</button>
                                            </form>
                                        }

                                        @if (!account.IsApproved && account.Role == AccountRole.AitsUser)
                                        {
                                            <form asp-action="Approve" method="post">
                                                <input type="hidden" name="id" value="@account.Id" />
                                                <button type="submit" class="ad-btn is-small">Approve agent</button>
                                            </form>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!rows.Any())
        {
            <p class="ad-empty">No users found. Add a customer user or agent to get started.</p>
        }
    </section>

</div>
