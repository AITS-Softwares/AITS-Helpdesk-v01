@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Agent sign in";
}

<style>
    .agent-login{width:100%;max-width:460px;margin:auto}
    .agent-login-kicker{display:inline-flex;align-items:center;gap:8px;margin:0 0 16px;padding:7px 11px;border:1px solid #d8eeec;border-radius:999px;background:#f1faf9;color:#0b737d;font-size:11px;font-weight:750;letter-spacing:.06em}
    .agent-login-kicker:before{content:"";width:8px;height:8px;border-radius:50%;background:#20a181;box-shadow:0 0 0 3px #d8f3e8}
    .agent-login h1{margin:0;color:#172b40;font-size:clamp(32px,3.2vw,40px);line-height:1.1;letter-spacing:-1.1px}
    .agent-login-intro{margin:11px 0 26px;color:#617286;font-size:15px;line-height:1.65}
    .agent-login-form{display:grid;gap:19px}
    .agent-login-field{display:grid;gap:8px}
    .agent-login-field label,.agent-login-label-row label{margin:0;color:#26384c;font-size:14px;font-weight:700}
    .agent-login-field input{width:100%;height:52px;padding:0 14px;border:1px solid #d7e0ea;border-radius:11px;background:#fff;color:#1c2c40;font-size:15px;transition:border-color .15s,box-shadow .15s}
    .agent-login-field input:focus{outline:0;border-color:#14828b;box-shadow:0 0 0 4px #14828b18}
    .agent-login-label-row{display:flex;align-items:center;justify-content:space-between;gap:12px}
    .agent-login-label-row a{color:#0b737d;font-size:13px;font-weight:650;text-decoration:none}
    .agent-login-label-row a:hover{text-decoration:underline}
    .agent-password-wrap{position:relative}
    .agent-password-wrap input{padding-right:52px}
    .agent-password-toggle{position:absolute;top:50%;right:8px;display:grid;place-items:center;width:38px;height:38px;transform:translateY(-50%);border:0;border-radius:8px;background:transparent;color:#66788b}
    .agent-password-toggle:hover{background:#f0f5f7;color:#0b737d}
    .agent-password-toggle svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
    .agent-login-submit{width:100%;min-height:52px;margin-top:3px;border:0;border-radius:11px;background:linear-gradient(105deg,#117b85,#0d8c87);box-shadow:0 8px 18px #0e7f851e;color:white;font-size:15px;font-weight:750;transition:transform .15s,box-shadow .15s}
    .agent-login-submit:hover{transform:translateY(-1px);box-shadow:0 11px 22px #0e7f852a}
    .agent-login-validation{margin-bottom:14px;color:#a42f43;font-size:13px}
    .agent-login-footer{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;margin:22px 0 0;padding-top:18px;border-top:1px solid #e7ebf0;color:#66778a;font-size:13px}
    .agent-login-footer a{color:#0b737d;font-weight:700;text-decoration:none}
    .agent-login-footer a:hover{text-decoration:underline}
    .agent-login-setup{margin:14px 0 0;color:#7b8998;font-size:12px}
    .agent-login-setup a{color:#536b80;font-weight:650}
    @@media(max-width:720px){.agent-login{max-width:none}.agent-login h1{font-size:32px}.agent-login-intro{font-size:14px;margin-bottom:22px}}
</style>

<section class="agent-login" aria-labelledby="agent-login-title">
    <span class="agent-login-kicker">AGENT &amp; ADMINISTRATOR PORTAL</span>
    <h1 id="agent-login-title">Welcome back</h1>
    <p class="agent-login-intro">Sign in to manage your support work and customer tickets.</p>

    <form asp-action="Login" method="post" class="agent-login-form" novalidate>
        <input asp-for="Area" type="hidden" />
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="All" class="agent-login-validation" role="alert"></div>

        <div class="agent-login-field">
            <label asp-for="Email">Work email</label>
            <input asp-for="Email" type="email" autocomplete="username" placeholder="name@company.com" required />
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>

        <div class="agent-login-field">
            <div class="agent-login-label-row"><label asp-for="Password"></label><a asp-action="ForgotPassword" asp-route-loginArea="@LoginArea.Aits">Forgot password?</a></div>
            <div class="agent-password-wrap">
                <input asp-for="Password" type="password" autocomplete="current-password" required />
                <button id="passwordToggle" class="agent-password-toggle" type="button" aria-controls="Password" aria-label="Show password" aria-pressed="false" title="Show password" hidden>
                    <svg class="eye-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                    <svg class="eye-closed" viewBox="0 0 24 24" aria-hidden="true" hidden><path d="m3 3 18 18M10.6 5.1 12 5c6.5 0 10 7 10 7a20 20 0 0 1-3.1 4.1M6.2 6.2A23 23 0 0 0 2 12s3.5 7 10 7c1.7 0 3.2-.5 4.5-1.2M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>
                </button>
            </div>
            <span asp-validation-for="Password" class="field-validation-error"></span>
        </div>

        <button type="submit" class="agent-login-submit">Sign in to workspace <span aria-hidden="true">→</span></button>
    </form>

    <div class="agent-login-footer"><span>New agent?</span><a asp-action="AitsSignup">Request an agent account</a></div>
    @if (ViewBag.CanSetup == true) { <p class="agent-login-setup">First time here? <a asp-action="Setup">Set up the first administrator</a></p> }
</section>

@section Scripts {
    <script>
        const passwordInput = document.getElementById('Password');
        const passwordToggle = document.getElementById('passwordToggle');
        function setPasswordVisible(visible) {
            passwordInput.type = visible ? 'text' : 'password';
            const label = visible ? 'Hide password' : 'Show password';
            passwordToggle.setAttribute('aria-label', label);
            passwordToggle.setAttribute('aria-pressed', String(visible));
            passwordToggle.title = label;
            passwordToggle.querySelector('.eye-open').toggleAttribute('hidden', visible);
            passwordToggle.querySelector('.eye-closed').toggleAttribute('hidden', !visible);
        }
        passwordToggle.hidden = false;
        passwordToggle.addEventListener('click', () => setPasswordVisible(passwordInput.type === 'password'));
        passwordInput.form.addEventListener('submit', () => setPasswordVisible(false));
        window.addEventListener('pagehide', () => setPasswordVisible(false));
    </script>
}
