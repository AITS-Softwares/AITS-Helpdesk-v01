@model SetupAdminViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "First admin setup";
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700&family=Figtree:wght@400;500;600&display=swap" />

<style>
    .aits-setup-page {
        --ink: #14263a;
        --ink-soft: #c9d6e2;
        --teal: #0f7b8a;
        --teal-dark: #0b5f6b;
        --tint: #e4f1f0;
        --signal: #f2b544;
        --page: #eef2f5;
        --surface: #ffffff;
        --text: #1b2733;
        --muted: #5b6b7a;
        --line: #d5dde4;
        --danger: #b3261e;
        font-family: "Figtree", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        color: var(--text);
        background: var(--page);
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: clamp(1rem, 4vw, 3rem);
        box-sizing: border-box;
    }

        .aits-setup-page *,
        .aits-setup-page *::before,
        .aits-setup-page *::after {
            box-sizing: border-box;
        }

    .aits-card {
        width: 100%;
        max-width: 34rem;
        background: var(--surface);
        border-radius: 1.25rem;
        overflow: hidden;
        box-shadow: 0 1px 2px rgba(20, 38, 58, 0.06), 0 12px 32px rgba(20, 38, 58, 0.1);
    }

    /* ---------- Header band ---------- */
    .aits-head {
        background: var(--ink);
        color: #fff;
        padding: clamp(1.5rem, 5vw, 2.25rem);
    }

        .aits-head h2 {
            font-family: "Bricolage Grotesque", "Figtree", system-ui, sans-serif;
            font-size: clamp(1.5rem, 5vw, 1.9rem);
            line-height: 1.15;
            margin: 0 0 0.5rem;
            letter-spacing: -0.01em;
        }

        .aits-head p {
            margin: 0;
            color: var(--ink-soft);
            line-height: 1.55;
        }

    /* ---------- Body ---------- */
    .aits-body {
        padding: clamp(1.5rem, 5vw, 2.25rem);
    }

    .aits-notice {
        margin: 0 0 1.25rem;
        padding: 0.75rem 1rem;
        background: #fdf1d6;
        border: 1px solid #f1dba6;
        border-radius: 0.6rem;
        color: #6f4a00;
        font-size: 0.9rem;
        line-height: 1.45;
    }

    .aits-form {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem 1.1rem;
    }

    .aits-field {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        min-width: 0;
    }

        .aits-field label {
            font-weight: 600;
            font-size: 0.92rem;
            color: var(--ink);
        }

        .aits-field input {
            width: 100%;
            font: inherit;
            color: var(--text);
            background: #fff;
            border: 1.5px solid var(--line);
            border-radius: 0.6rem;
            padding: 0.7rem 0.85rem;
            min-height: 2.9rem;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

            .aits-field input:hover {
                border-color: #b4c1cc;
            }

            .aits-field input:focus-visible {
                outline: none;
                border-color: var(--teal);
                box-shadow: 0 0 0 3px rgba(15, 123, 138, 0.22);
            }

            .aits-field input.input-validation-error {
                border-color: var(--danger);
            }

        .aits-field .field-validation-error {
            color: var(--danger);
            font-size: 0.85rem;
        }

    .aits-hint {
        font-size: 0.82rem;
        color: var(--muted);
    }

    .aits-pw {
        position: relative;
    }

        .aits-pw input {
            padding-right: 4.2rem;
        }

    .aits-pw-toggle {
        position: absolute;
        right: 0.35rem;
        top: 50%;
        transform: translateY(-50%);
        border: 0;
        background: transparent;
        color: var(--teal-dark);
        font: inherit;
        font-size: 0.85rem;
        font-weight: 600;
        padding: 0.4rem 0.55rem;
        border-radius: 0.4rem;
        cursor: pointer;
    }

        .aits-pw-toggle:hover {
            background: var(--tint);
        }

        .aits-pw-toggle:focus-visible {
            outline: 2px solid var(--teal);
            outline-offset: 1px;
        }

    .aits-body .validation {
        grid-column: 1 / -1;
        background: #fdecea;
        border: 1px solid #f3c1bd;
        color: var(--danger);
        border-radius: 0.6rem;
        padding: 0.75rem 1rem;
        font-size: 0.92rem;
    }

        .aits-body .validation.validation-summary-valid,
        .aits-body .validation:empty {
            display: none;
        }

        .aits-body .validation ul {
            margin: 0;
            padding-left: 1.1rem;
        }

    .aits-submit {
        grid-column: 1 / -1;
        margin-top: 0.4rem;
        font: inherit;
        font-weight: 600;
        font-size: 1rem;
        color: #fff;
        background: var(--teal);
        border: 0;
        border-radius: 0.65rem;
        min-height: 3rem;
        padding: 0.75rem 1.25rem;
        cursor: pointer;
        transition: background 0.15s, transform 0.05s;
    }

        .aits-submit:hover {
            background: var(--teal-dark);
        }

        .aits-submit:active {
            transform: translateY(1px);
        }

        .aits-submit:focus-visible {
            outline: 3px solid var(--signal);
            outline-offset: 2px;
        }

    .aits-back {
        margin: 1.5rem 0 0;
        padding-top: 1.1rem;
        border-top: 1px solid var(--line);
        font-size: 0.92rem;
    }

        .aits-back a {
            color: var(--teal-dark);
            font-weight: 600;
            text-underline-offset: 3px;
        }

            .aits-back a:focus-visible {
                outline: 2px solid var(--signal);
                outline-offset: 2px;
                border-radius: 2px;
            }

    /* ---------- Responsive ---------- */
    @@media (min-width: 40rem) {
        .aits-form {
            grid-template-columns: 1fr 1fr;
        }

        .aits-field.is-wide {
            grid-column: 1 / -1;
        }
    }

    @@media (max-width: 30rem) {
        .aits-setup-page {
            padding: 0.75rem;
            align-items: start;
        }

        .aits-card {
            border-radius: 1rem;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .aits-setup-page * {
            transition: none !important;
        }
    }
</style>

<div class="aits-setup-page">
    <div class="aits-card">

        <header class="aits-head">
            <h2>Create the AITS administrator</h2>
            <p>This page is available on this computer until the first admin account is created.</p>
        </header>

        <main class="aits-body">
            <p class="aits-notice">This is a one-time setup. Once the first admin exists, this page is no longer available.</p>

            <form asp-action="Setup" method="post" class="aits-form" novalidate>
                <div asp-validation-summary="All" class="validation" role="alert"></div>

                <div class="aits-field">
                    <label asp-for="Name">Admin name</label>
                    <input asp-for="Name" maxlength="80" required autocomplete="name" />
                    <span asp-validation-for="Name"></span>
                </div>

                <div class="aits-field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" type="email" maxlength="160" required autocomplete="username" />
                    <span asp-validation-for="Email"></span>
                </div>

                <div class="aits-field">
                    <label asp-for="Password"></label>
                    <div class="aits-pw">
                        <input asp-for="Password" type="password" minlength="8" maxlength="128" required autocomplete="new-password" />
                        <button type="button" class="aits-pw-toggle" data-target="Password" aria-label="Show password">Show</button>
                    </div>
                    <small class="aits-hint">Use at least 8 characters. There is no default password.</small>
                    <span asp-validation-for="Password"></span>
                </div>

                <div class="aits-field">
                    <label asp-for="ConfirmPassword">Confirm password</label>
                    <div class="aits-pw">
                        <input asp-for="ConfirmPassword" type="password" minlength="8" maxlength="128" required autocomplete="new-password" />
                        <button type="button" class="aits-pw-toggle" data-target="ConfirmPassword" aria-label="Show confirmation password">Show</button>
                    </div>
                    <span asp-validation-for="ConfirmPassword"></span>
                </div>

                <button class="aits-submit" type="submit">Create admin account</button>
            </form>

            <p class="aits-back"><a asp-action="AitsLogin">Back to sign in</a></p>
        </main>

    </div>
</div>

<script>
    document.querySelectorAll('.aits-pw-toggle').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var input = document.getElementById(btn.dataset.target);
        var show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        btn.textContent = show ? 'Hide' : 'Show';
        btn.setAttribute('aria-pressed', show);
      });
    });
</script>