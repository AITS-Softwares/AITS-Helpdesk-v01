@model SetupAdminViewModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "First admin setup"; }
<p class="eyebrow">ONE-TIME LOCAL SETUP</p><h2>Create the AITS administrator</h2><p class="muted">This page is available on this computer until the first admin account is created.</p>
<form asp-action="Setup" method="post"><div asp-validation-summary="All" class="validation" role="alert"></div><label asp-for="Name">Admin name</label><input asp-for="Name" maxlength="80" required autocomplete="name" /><label asp-for="Email"></label><input asp-for="Email" type="email" maxlength="160" required autocomplete="username" /><label asp-for="Password"></label><input asp-for="Password" type="password" minlength="8" maxlength="128" required autocomplete="new-password" /><small class="muted">Use at least 8 characters. There is no default password.</small><label asp-for="ConfirmPassword">Confirm password</label><input asp-for="ConfirmPassword" type="password" minlength="8" maxlength="128" required autocomplete="new-password" /><button class="button auth-submit" type="submit">Create admin account</button></form><p class="auth-link"><a asp-action="AitsLogin">Back to sign in</a></p>
