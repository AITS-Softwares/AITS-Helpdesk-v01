@model StaffSignupViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Agent account request";
}

<style>
    .agent-signup{width:100%;max-width:540px;margin:auto}
    .agent-signup-kicker{display:inline-flex;align-items:center;gap:8px;margin:0 0 14px;padding:7px 11px;border:1px solid #d8eeec;border-radius:999px;background:#f1faf9;color:#0b737d;font-size:11px;font-weight:750;letter-spacing:.06em}
    .agent-signup-kicker:before{content:"";width:8px;height:8px;border-radius:50%;background:#20a181;box-shadow:0 0 0 3px #d8f3e8}
    .agent-signup h1{margin:0;color:#172b40;font-size:clamp(30px,3vw,37px);line-height:1.12;letter-spacing:-.9px}
    .agent-signup-intro{margin:9px 0 19px;color:#617286;font-size:14px;line-height:1.6}
    .agent-signup-note{display:flex;align-items:flex-start;gap:10px;margin:0 0 20px;padding:12px 14px;border:1px solid #e2e8f0;border-radius:11px;background:linear-gradient(105deg,#f7f9fc,#f4faf9);color:#5d6f82;font-size:12px;line-height:1.5}
    .agent-signup-note strong{color:#273a4f}
    .agent-signup-note-icon{display:grid;place-items:center;flex:0 0 25px;width:25px;height:25px;border-radius:8px;background:#e5f4f0;color:#16846c;font-size:14px;font-weight:800}
    .agent-signup-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px 13px}
    .agent-signup-field{display:grid;align-content:start;gap:7px;min-width:0}
    .agent-signup-field.is-wide,.agent-signup-validation,.agent-signup-submit{grid-column:1/-1}
    .agent-signup-field label{margin:0;color:#26384c;font-size:13px;font-weight:700}
    .agent-signup-field input{width:100%;height:47px;padding:0 12px;border:1px solid #d7e0ea;border-radius:10px;background:#fff;color:#1c2c40;font-size:14px;transition:border-color .15s,box-shadow .15s}
    .agent-signup-field input:focus{outline:0;border-color:#14828b;box-shadow:0 0 0 4px #14828b18}
    .agent-signup-field small{margin-top:-2px;color:#77879a;font-size:11px;line-height:1.4}
    .agent-signup-password{position:relative}
    .agent-signup-password input{padding-right:58px}
    .agent-signup-toggle{position:absolute;top:50%;right:7px;padding:6px 8px;transform:translateY(-50%);border:0;border-radius:7px;background:transparent;color:#0b737d;font-size:11px;font-weight:700}
    .agent-signup-toggle:hover{background:#eef7f6}
    .agent-signup-validation{margin:0;color:#a42f43;font-size:12px}
    .agent-signup-submit{width:100%;min-height:49px;margin-top:2px;border:0;border-radius:10px;background:linear-gradient(105deg,#117b85,#0d8c87);box-shadow:0 8px 18px #0e7f851e;color:#fff;font-size:14px;font-weight:750;transition:transform .15s,box-shadow .15s}
    .agent-signup-submit:hover{transform:translateY(-1px);box-shadow:0 11px 22px #0e7f852a}
    .agent-signup-footer{display:flex;justify-content:space-between;gap:12px;margin:19px 0 0;padding-top:16px;border-top:1px solid #e7ebf0;color:#66778a;font-size:12px}
    .agent-signup-footer a{color:#0b737d;font-weight:700;text-decoration:none}.agent-signup-footer a:hover{text-decoration:underline}
    .agent-signup-setup{margin:12px 0 0;color:#78889a;font-size:11px}.agent-signup-setup a{color:#536b80;font-weight:650}
    @@media(max-width:480px){.agent-signup-form{grid-template-columns:1fr;gap:13px}.agent-signup-field.is-wide,.agent-signup-validation,.agent-signup-submit{grid-column:auto}.agent-signup h1{font-size:30px}.agent-signup-footer{flex-wrap:wrap}}
</style>

<section class="agent-signup" aria-labelledby="agent-signup-title">
    <span class="agent-signup-kicker">JOIN THE AITS TEAM</span>
    <h1 id="agent-signup-title">Request an agent account</h1>
    <p class="agent-signup-intro">Create your profile with your AITS work email. An administrator will review your request.</p>
    <div class="agent-signup-note"><span class="agent-signup-note-icon" aria-hidden="true">✓</span><span><strong>Approval keeps the workspace secure.</strong> We’ll enable your sign-in after your team confirms your account.</span></div>

    <form asp-action="AitsSignup" method="post" class="agent-signup-form" novalidate>
        <div asp-validation-summary="All" class="agent-signup-validation" role="alert"></div>
        <div class="agent-signup-field"><label asp-for="Name">Full name</label><input asp-for="Name" maxlength="80" autocomplete="name" placeholder="Your name" required /><span asp-validation-for="Name"></span></div>
        <div class="agent-signup-field"><label asp-for="Department"></label><input asp-for="Department" maxlength="80" placeholder="e.g. Support" required /><span asp-validation-for="Department"></span></div>
        <div class="agent-signup-field is-wide"><label asp-for="Email">AITS work email</label><input asp-for="Email" type="email" maxlength="160" autocomplete="username" placeholder="name@aitsind.com" required /><span asp-validation-for="Email"></span></div>
        <div class="agent-signup-field"><label asp-for="Password"></label><div class="agent-signup-password"><input asp-for="Password" type="password" autocomplete="new-password" minlength="8" maxlength="128" placeholder="At least 8 characters" required /><button type="button" class="agent-signup-toggle" data-target="Password" aria-label="Show password" aria-pressed="false">Show</button></div><span asp-validation-for="Password"></span></div>
        <div class="agent-signup-field"><label asp-for="ConfirmPassword">Confirm password</label><div class="agent-signup-password"><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="128" placeholder="Re-enter password" required /><button type="button" class="agent-signup-toggle" data-target="ConfirmPassword" aria-label="Show confirmation password" aria-pressed="false">Show</button></div><span asp-validation-for="ConfirmPassword"></span></div>
        <button class="agent-signup-submit" type="submit">Submit account request <span aria-hidden="true">→</span></button>
    </form>

    <div class="agent-signup-footer"><span>Already have an account?</span><a asp-action="AitsLogin">Sign in</a></div>
    @if (ViewBag.CanSetup == true) { <p class="agent-signup-setup">First time here? <a asp-action="Setup">Set up the first administrator</a></p> }
</section>

<script>
    document.querySelectorAll('.agent-signup-toggle').forEach(function (button) {
        button.addEventListener('click', function () {
            var input = document.getElementById(button.dataset.target);
            var showing = input.type === 'password';
            input.type = showing ? 'text' : 'password';
            button.textContent = showing ? 'Hide' : 'Show';
            button.setAttribute('aria-label', showing ? 'Hide password' : 'Show password');
            button.setAttribute('aria-pressed', String(showing));
        });
    });
</script>
