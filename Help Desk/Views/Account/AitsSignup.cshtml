@model StaffSignupViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "AITS sign up";
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700&family=Figtree:wght@400;500;600&display=swap" />

<style>
    .aits-signup {
        --ink: #14263a;
        --ink-soft: #c9d6e2;
        --teal: #0f7b8a;
        --teal-dark: #0b5f6b;
        --tint: #e4f1f0;
        --signal: #f2b544;
        --page: #eef2f5;
        --surface: #ffffff;
        --text: #1b2733;
        --muted: #5b6b7a;
        --line: #d5dde4;
        --danger: #b3261e;
        font-family: "Figtree", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        color: var(--text);
        background: var(--page);
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: clamp(1rem, 4vw, 3rem);
        box-sizing: border-box;
    }

        .aits-signup *,
        .aits-signup *::before,
        .aits-signup *::after {
            box-sizing: border-box;
        }

    .aits-card {
        width: 100%;
        max-width: 62rem;
        display: grid;
        grid-template-columns: 1fr;
        background: var(--surface);
        border-radius: 1.25rem;
        overflow: hidden;
        box-shadow: 0 1px 2px rgba(20, 38, 58, 0.06), 0 12px 32px rgba(20, 38, 58, 0.1);
    }

    /* ---------- Left panel ---------- */
    .aits-aside {
        background: var(--ink);
        color: #fff;
        padding: clamp(1.5rem, 4vw, 3rem);
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

        .aits-aside h1 {
            font-family: "Bricolage Grotesque", "Figtree", system-ui, sans-serif;
            font-size: clamp(1.6rem, 3.4vw, 2.2rem);
            line-height: 1.1;
            margin: 0;
            letter-spacing: -0.01em;
        }

        .aits-aside p {
            margin: 0;
            color: var(--ink-soft);
            line-height: 1.55;
            max-width: 34ch;
        }

    .aits-steps {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
    }

        .aits-steps li {
            position: relative;
            display: grid;
            grid-template-columns: 2rem 1fr;
            column-gap: 0.9rem;
            padding-bottom: 1.25rem;
        }

            .aits-steps li:last-child {
                padding-bottom: 0;
            }

            .aits-steps li:not(:last-child)::after {
                content: "";
                position: absolute;
                left: 0.95rem;
                top: 2rem;
                bottom: 0.15rem;
                width: 2px;
                background: rgba(255, 255, 255, 0.18);
            }

    .aits-step-dot {
        width: 2rem;
        height: 2rem;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-weight: 600;
        font-size: 0.9rem;
        border: 2px solid rgba(255, 255, 255, 0.3);
        color: #fff;
    }

    .aits-steps li.is-current .aits-step-dot {
        background: var(--signal);
        border-color: var(--signal);
        color: var(--ink);
    }

    .aits-steps strong {
        display: block;
        font-weight: 600;
        line-height: 2rem;
    }

    .aits-steps span {
        color: var(--ink-soft);
        font-size: 0.92rem;
        line-height: 1.45;
    }

    .aits-aside .aits-aside-links {
        margin-top: auto;
        font-size: 0.92rem;
    }

    .aits-aside-links a {
        color: #fff;
        font-weight: 600;
    }

    /* ---------- Right panel ---------- */
    .aits-main {
        padding: clamp(1.5rem, 4vw, 3rem);
    }

        .aits-main h2 {
            font-family: "Bricolage Grotesque", "Figtree", system-ui, sans-serif;
            font-size: clamp(1.5rem, 3vw, 1.9rem);
            margin: 0 0 0.35rem;
            color: var(--ink);
            letter-spacing: -0.01em;
        }

        .aits-main .aits-lead {
            margin: 0 0 1.5rem;
            color: var(--muted);
            line-height: 1.5;
        }

    .aits-form {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem 1.1rem;
    }

    .aits-field {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        min-width: 0;
    }

        .aits-field label {
            font-weight: 600;
            font-size: 0.92rem;
            color: var(--ink);
        }

        .aits-field input {
            width: 100%;
            font: inherit;
            color: var(--text);
            background: #fff;
            border: 1.5px solid var(--line);
            border-radius: 0.6rem;
            padding: 0.7rem 0.85rem;
            min-height: 2.9rem;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

            .aits-field input:hover {
                border-color: #b4c1cc;
            }

            .aits-field input:focus-visible {
                outline: none;
                border-color: var(--teal);
                box-shadow: 0 0 0 3px rgba(15, 123, 138, 0.22);
            }

            .aits-field input.input-validation-error {
                border-color: var(--danger);
            }

    .aits-hint {
        font-size: 0.82rem;
        color: var(--muted);
    }

    .aits-field .field-validation-error {
        color: var(--danger);
        font-size: 0.85rem;
    }

    .aits-pw {
        position: relative;
    }

        .aits-pw input {
            padding-right: 4.2rem;
        }

    .aits-pw-toggle {
        position: absolute;
        right: 0.35rem;
        top: 50%;
        transform: translateY(-50%);
        border: 0;
        background: transparent;
        color: var(--teal-dark);
        font: inherit;
        font-size: 0.85rem;
        font-weight: 600;
        padding: 0.4rem 0.55rem;
        border-radius: 0.4rem;
        cursor: pointer;
    }

        .aits-pw-toggle:hover {
            background: var(--tint);
        }

        .aits-pw-toggle:focus-visible {
            outline: 2px solid var(--teal);
            outline-offset: 1px;
        }

    .aits-main .validation {
        grid-column: 1 / -1;
        background: #fdecea;
        border: 1px solid #f3c1bd;
        color: var(--danger);
        border-radius: 0.6rem;
        padding: 0.75rem 1rem;
        font-size: 0.92rem;
    }

        .aits-main .validation.validation-summary-valid,
        .aits-main .validation:empty {
            display: none;
        }

        .aits-main .validation ul {
            margin: 0;
            padding-left: 1.1rem;
        }

    .aits-submit {
        grid-column: 1 / -1;
        margin-top: 0.4rem;
        font: inherit;
        font-weight: 600;
        font-size: 1rem;
        color: #fff;
        background: var(--teal);
        border: 0;
        border-radius: 0.65rem;
        min-height: 3rem;
        padding: 0.75rem 1.25rem;
        cursor: pointer;
        transition: background 0.15s, transform 0.05s;
    }

        .aits-submit:hover {
            background: var(--teal-dark);
        }

        .aits-submit:active {
            transform: translateY(1px);
        }

        .aits-submit:focus-visible {
            outline: 3px solid var(--signal);
            outline-offset: 2px;
        }

    .aits-footer-links {
        margin: 1.5rem 0 0;
        padding-top: 1.1rem;
        border-top: 1px solid var(--line);
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 1.5rem;
        font-size: 0.92rem;
        color: var(--muted);
    }

        .aits-footer-links a,
        .aits-setup a {
            color: var(--teal-dark);
            font-weight: 600;
            text-underline-offset: 3px;
        }

            .aits-footer-links a:focus-visible,
            .aits-setup a:focus-visible,
            .aits-aside-links a:focus-visible {
                outline: 2px solid var(--signal);
                outline-offset: 2px;
                border-radius: 2px;
            }

    .aits-setup {
        margin: 0.9rem 0 0;
        font-size: 0.88rem;
    }

    /* ---------- Responsive ---------- */
    @@media (min-width: 40rem) {
        .aits-form {
            grid-template-columns: 1fr 1fr;
        }

        .aits-field.is-wide {
            grid-column: 1 / -1;
        }
    }

    @@media (min-width: 62rem) {
        .aits-card {
            grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        }
    }

    @@media (max-width: 61.99rem) {
        .aits-steps,
        .aits-aside .aits-aside-links {
            display: none;
        }

        .aits-aside {
            gap: 0.75rem;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .aits-signup * {
            transition: none !important;
        }
    }
</style>

<div class="aits-signup">
    <div class="aits-card">

        <aside class="aits-aside">
            <h1>Join the AITS agent team</h1>
            <p>Register to handle client requests. An administrator reviews every account before it goes live.</p>

            <ol class="aits-steps">
                <li class="is-current">
                    <span class="aits-step-dot">1</span>
                    <div><strong>Create your account</strong><span>Fill in your details on this page.</span></div>
                </li>
                <li>
                    <span class="aits-step-dot">2</span>
                    <div><strong>Wait for approval</strong><span>An administrator checks your request.</span></div>
                </li>
                <li>
                    <span class="aits-step-dot">3</span>
                    <div><strong>Sign in and start work</strong><span>You get access once you're approved.</span></div>
                </li>
            </ol>

            <p class="aits-aside-links">Customer? <a asp-action="Signup">Create a client account</a></p>
        </aside>

        <main class="aits-main">
            <h2>Create an agent account</h2>
            <p class="aits-lead">Use your AITS work email so we can match you to your team.</p>

            <form asp-action="AitsSignup" method="post" class="aits-form" novalidate>
                <div asp-validation-summary="All" class="validation" role="alert"></div>

                <div class="aits-field">
                    <label asp-for="Name">Full name</label>
                    <input asp-for="Name" maxlength="80" autocomplete="name" required />
                    <span asp-validation-for="Name"></span>
                </div>

                <div class="aits-field">
                    <label asp-for="Department"></label>
                    <input asp-for="Department" maxlength="80" required />
                    <span asp-validation-for="Department"></span>
                </div>

                <div class="aits-field is-wide">
                    <label asp-for="Email">AITS work email</label>
                    <input asp-for="Email" type="email" maxlength="160" autocomplete="username" required />
                    <span asp-validation-for="Email"></span>
                </div>

                <div class="aits-field">
                    <label asp-for="Password"></label>
                    <div class="aits-pw">
                        <input asp-for="Password" type="password" autocomplete="new-password" minlength="8" maxlength="128" required />
                        <button type="button" class="aits-pw-toggle" data-target="Password" aria-label="Show password">Show</button>
                    </div>
                    <small class="aits-hint">Use at least 8 characters.</small>
                    <span asp-validation-for="Password"></span>
                </div>

                <div class="aits-field">
                    <label asp-for="ConfirmPassword">Confirm password</label>
                    <div class="aits-pw">
                        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="128" required />
                        <button type="button" class="aits-pw-toggle" data-target="ConfirmPassword" aria-label="Show confirmation password">Show</button>
                    </div>
                    <span asp-validation-for="ConfirmPassword"></span>
                </div>

                <button class="aits-submit" type="submit">Register agent account</button>
            </form>

            <div class="aits-footer-links">
                <span>Already registered? <a asp-action="AitsLogin">AITS sign in</a></span>
                <span>A customer? <a asp-action="Signup">Client sign up</a></span>
            </div>

            @if (ViewBag.CanSetup == true)
            {
                <p class="aits-setup"><a asp-action="Setup">Set up the first AITS admin</a></p>
            }
        </main>

    </div>
</div>

<script>
    document.querySelectorAll('.aits-pw-toggle').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var input = document.getElementById(btn.dataset.target);
        var show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        btn.textContent = show ? 'Hide' : 'Show';
        btn.setAttribute('aria-pressed', show);
      });
    });
</script>