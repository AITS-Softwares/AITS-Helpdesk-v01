@model StaffSignupViewModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "AITS sign up"; }
<p class="eyebrow">AITS TEAM REGISTRATION</p><h2>Create an AITS account</h2><p class="muted">Register as an AITS staff member. An administrator will review and approve your access.</p>
<form asp-action="AitsSignup" method="post"><div asp-validation-summary="All" class="validation" role="alert"></div><label asp-for="Name">Full name</label><input asp-for="Name" maxlength="80" autocomplete="name" required /><label asp-for="Email">AITS work email</label><input asp-for="Email" type="email" maxlength="160" autocomplete="username" required /><label asp-for="Department"></label><input asp-for="Department" maxlength="80" required /><label asp-for="Password"></label><input asp-for="Password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required /><small class="muted">Use at least 12 characters.</small><label asp-for="ConfirmPassword">Confirm password</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="12" maxlength="128" required /><button class="button auth-submit" type="submit">Register AITS account</button></form><p class="auth-link">Already registered? <a asp-action="AitsLogin">AITS sign in</a></p><p class="auth-link">A client user? <a asp-action="Signup">Client sign up</a></p>
@if (ViewBag.CanSetup == true) { <p class="setup-link"><a asp-action="Setup">Set up the first AITS admin</a></p> }
