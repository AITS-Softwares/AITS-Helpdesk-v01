@model AdminResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
    var account = Model.Account!;
    var roleLabel = account.Role == AccountRole.Admin ? "Administrator" : account.Role == AccountRole.AitsUser ? "Agent" : "Customer user";
    var initial = string.IsNullOrWhiteSpace(account.Name) ? "?" : account.Name.Trim().Substring(0, 1).ToUpper();
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700&family=Figtree:wght@400;500;600&display=swap" />

<style>
    .rp-page {
        --ink: #14263a;
        --teal: #0f7b8a;
        --teal-dark: #0b5f6b;
        --tint: #e4f1f0;
        --signal: #f2b544;
        --surface: #ffffff;
        --soft: #f5f8fa;
        --text: #1b2733;
        --muted: #5b6b7a;
        --line: #d5dde4;
        --danger: #b3261e;
        font-family: "Figtree", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        color: var(--text);
        max-width: 44rem;
        margin: 0 auto;
        padding: clamp(0.75rem, 3vw, 2rem);
    }

        .rp-page *,
        .rp-page *::before,
        .rp-page *::after {
            box-sizing: border-box;
        }

    .rp-back {
        display: inline-block;
        margin-bottom: 0.9rem;
        color: var(--teal-dark);
        font-weight: 600;
        font-size: 0.92rem;
        text-decoration: none;
        text-underline-offset: 3px;
    }

        .rp-back:hover {
            text-decoration: underline;
        }

    .rp-heading h1 {
        font-family: "Bricolage Grotesque", "Figtree", system-ui, sans-serif;
        font-size: clamp(1.5rem, 4vw, 2.1rem);
        line-height: 1.1;
        letter-spacing: -0.01em;
        margin: 0 0 0.4rem;
        color: var(--ink);
    }

    .rp-heading p {
        margin: 0 0 1.5rem;
        color: var(--muted);
        line-height: 1.5;
    }

    /* ---------- Card ---------- */
    .rp-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 1px 2px rgba(20, 38, 58, 0.04), 0 8px 24px rgba(20, 38, 58, 0.06);
    }

    /* account summary band */
    .rp-account {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 0.9rem;
        padding: clamp(1rem, 3vw, 1.4rem) clamp(1rem, 3vw, 1.75rem);
        background: var(--ink);
        color: #fff;
    }

    .rp-avatar {
        width: 2.8rem;
        height: 2.8rem;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: var(--signal);
        color: var(--ink);
        font-weight: 700;
        font-size: 1.1rem;
    }

    .rp-account-info {
        min-width: 0;
    }

        .rp-account-info strong {
            display: block;
            font-size: 1.05rem;
            overflow-wrap: anywhere;
        }

        .rp-account-info span {
            color: #c9d6e2;
            font-size: 0.9rem;
            overflow-wrap: anywhere;
        }

    .rp-role {
        padding: 0.25rem 0.7rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.14);
        font-size: 0.82rem;
        font-weight: 600;
        white-space: nowrap;
    }

    /* form */
    .rp-form {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem 1.1rem;
        padding: clamp(1rem, 3vw, 1.75rem);
    }

    .rp-field {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        min-width: 0;
    }

        .rp-field label {
            font-weight: 600;
            font-size: 0.92rem;
            color: var(--ink);
        }

        .rp-field input {
            width: 100%;
            font: inherit;
            color: var(--text);
            background: #fff;
            border: 1.5px solid var(--line);
            border-radius: 0.6rem;
            padding: 0.7rem 0.85rem;
            min-height: 2.9rem;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

            .rp-field input:hover {
                border-color: #b4c1cc;
            }

            .rp-field input:focus-visible {
                outline: none;
                border-color: var(--teal);
                box-shadow: 0 0 0 3px rgba(15, 123, 138, 0.22);
            }

            .rp-field input.input-validation-error {
                border-color: var(--danger);
            }

        .rp-field .field-validation-error {
            color: var(--danger);
            font-size: 0.85rem;
        }

    .rp-hint {
        font-size: 0.82rem;
        color: var(--muted);
    }

    .rp-pw {
        position: relative;
    }

        .rp-pw input {
            padding-right: 4.2rem;
        }

    .rp-pw-toggle {
        position: absolute;
        right: 0.35rem;
        top: 50%;
        transform: translateY(-50%);
        border: 0;
        background: transparent;
        color: var(--teal-dark);
        font: inherit;
        font-size: 0.85rem;
        font-weight: 600;
        padding: 0.4rem 0.55rem;
        border-radius: 0.4rem;
        cursor: pointer;
    }

        .rp-pw-toggle:hover {
            background: var(--tint);
        }

        .rp-pw-toggle:focus-visible {
            outline: 2px solid var(--teal);
            outline-offset: 1px;
        }

    .rp-notice {
        grid-column: 1 / -1;
        margin: 0;
        padding: 0.75rem 1rem;
        background: #fdf1d6;
        border: 1px solid #f1dba6;
        border-radius: 0.6rem;
        color: #6f4a00;
        font-size: 0.9rem;
        line-height: 1.45;
    }

    .rp-form .validation {
        grid-column: 1 / -1;
        background: #fdecea;
        border: 1px solid #f3c1bd;
        color: var(--danger);
        border-radius: 0.6rem;
        padding: 0.75rem 1rem;
        font-size: 0.92rem;
    }

        .rp-form .validation.validation-summary-valid,
        .rp-form .validation:empty {
            display: none;
        }

        .rp-form .validation ul {
            margin: 0;
            padding-left: 1.1rem;
        }

    .rp-actions {
        grid-column: 1 / -1;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem 1.25rem;
        margin-top: 0.3rem;
        padding-top: 1.1rem;
        border-top: 1px solid var(--line);
    }

    .rp-submit {
        font: inherit;
        font-weight: 600;
        font-size: 1rem;
        color: #fff;
        background: var(--teal);
        border: 0;
        border-radius: 0.65rem;
        min-height: 2.9rem;
        padding: 0.6rem 1.4rem;
        cursor: pointer;
        transition: background 0.15s, transform 0.05s;
    }

        .rp-submit:hover {
            background: var(--teal-dark);
        }

        .rp-submit:active {
            transform: translateY(1px);
        }

    .rp-cancel {
        color: var(--muted);
        font-weight: 600;
        text-underline-offset: 3px;
    }

    .rp-submit:focus-visible {
        outline: 3px solid var(--signal);
        outline-offset: 2px;
    }

    .rp-back:focus-visible,
    .rp-cancel:focus-visible {
        outline: 2px solid var(--signal);
        outline-offset: 2px;
        border-radius: 2px;
    }

    /* ---------- Responsive ---------- */
    @@media (min-width: 40rem) {
        .rp-form {
            grid-template-columns: 1fr 1fr;
        }

        .rp-field.is-wide {
            grid-column: 1 / -1;
        }
    }

    @@media (max-width: 30rem) {
        .rp-account {
            grid-template-columns: auto 1fr;
        }

        .rp-role {
            grid-column: 1 / -1;
            justify-self: start;
        }

        .rp-actions {
            flex-direction: column-reverse;
            align-items: stretch;
            text-align: center;
        }

        .rp-submit {
            width: 100%;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .rp-page * {
            transition: none !important;
        }
    }
</style>

<div class="rp-page">

    <div class="rp-heading">
        <a class="rp-back" asp-action="Index" asp-route-clients="@(account is ClientAccount)">← Back to accounts</a>
        <h1>Reset password</h1>
        <p>Verify the user's identity before setting a new password. Existing sessions will be revoked.</p>
    </div>

    <form asp-action="ResetPassword" asp-route-id="@account.Id" method="post" class="rp-card" novalidate>

        <div class="rp-account">
            <span class="rp-avatar" aria-hidden="true">@initial</span>
            <div class="rp-account-info">
                <strong>@account.Name</strong>
                <span>@account.Email</span>
            </div>
            <span class="rp-role">@roleLabel</span>
        </div>

        <div class="rp-form">
            <div asp-validation-summary="All" class="validation" role="alert"></div>

            <div class="rp-field">
                <label for="resetName">Account</label>
                <input id="resetName" value="@account.Name" readonly />
            </div>

            <div class="rp-field">
                <label for="resetRole">Account type</label>
                <input id="resetRole" value="@roleLabel" readonly />
            </div>

            <div class="rp-field is-wide">
                <label for="resetEmail">Email address</label>
                <input id="resetEmail" value="@account.Email" readonly />
            </div>

            <div class="rp-field">
                <label asp-for="Password">New password</label>
                <div class="rp-pw">
                    <input asp-for="Password" type="password" minlength="8" maxlength="128" autocomplete="new-password" required />
                    <button type="button" class="rp-pw-toggle" data-target="Password" aria-label="Show new password">Show</button>
                </div>
                <small class="rp-hint">Use at least 8 characters.</small>
                <span asp-validation-for="Password"></span>
            </div>

            <div class="rp-field">
                <label asp-for="ConfirmPassword">Confirm new password</label>
                <div class="rp-pw">
                    <input asp-for="ConfirmPassword" type="password" minlength="8" maxlength="128" autocomplete="new-password" required />
                    <button type="button" class="rp-pw-toggle" data-target="ConfirmPassword" aria-label="Show confirmation password">Show</button>
                </div>
                <span asp-validation-for="ConfirmPassword"></span>
            </div>

            <p class="rp-notice">Saving signs this user out everywhere. Share the new password with them securely.</p>

            <div class="rp-actions">
                <button class="rp-submit" type="submit">Reset password</button>
                <a class="rp-cancel" asp-action="Index" asp-route-clients="@(account is ClientAccount)">Cancel</a>
            </div>
        </div>

    </form>
</div>

<script>
    document.querySelectorAll('.rp-pw-toggle').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var input = document.getElementById(btn.dataset.target);
        var show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        btn.textContent = show ? 'Hide' : 'Show';
        btn.setAttribute('aria-pressed', show);
      });
    });
</script>