@model AdminResetPasswordViewModel
@{ ViewData["Title"] = "Reset password"; var account = Model.Account!; }
<div class="page-heading"><div><a asp-action="Index" asp-route-clients="@(account is ClientAccount)">← Back to accounts</a><h1>Reset password</h1><p class="muted">Verify the user's identity before setting a new password. Existing sessions will be revoked.</p></div></div>
<form asp-action="ResetPassword" asp-route-id="@account.Id" method="post" class="panel form-panel">
    <div asp-validation-summary="All" class="validation" role="alert"></div>
    <label for="resetName">Account</label><input id="resetName" value="@account.Name" readonly />
    <label for="resetEmail">Email address</label><input id="resetEmail" value="@account.Email" readonly />
    <label for="resetRole">Account type</label><input id="resetRole" value="@(account.Role == AccountRole.Admin ? "Administrator" : account.Role == AccountRole.AitsUser ? "AITS staff" : "Client user")" readonly />
    <label asp-for="Password">New password</label><input asp-for="Password" type="password" minlength="8" maxlength="128" autocomplete="new-password" required /><small class="muted">Use at least 8 characters.</small>
    <label asp-for="ConfirmPassword">Confirm new password</label><input asp-for="ConfirmPassword" type="password" minlength="8" maxlength="128" autocomplete="new-password" required />
    <div class="form-actions"><button class="button" type="submit">Reset password</button><a asp-action="Index" asp-route-clients="@(account is ClientAccount)">Cancel</a></div>
</form>
