@model ProvisionAccountViewModel

@{
    var backController = User.IsInRole("Admin") ? "Account" : "MyWork";
    var backAction = User.IsInRole("Admin") ? "Index" : "ClientUsers";
    ViewData["Title"] = Model.Staff ? "Enable agent sign-in" : "Enable client sign-in";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - YourAppName</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
        body, input, select, button, label {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #333;
            font-size: 16px;
            line-height: 1.4;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            background-color: #f8f9fa;
            margin: 0;
            padding: 0;
        }

        a {
            color: #0078d7;
            text-decoration: none;
            cursor: pointer;
            transition: color 0.3s ease;
        }

            a:hover, a:focus {
                color: #005a9e;
                outline: none;
            }

        .page-heading {
            text-align: center;
            margin: 3rem 1rem 2rem;
        }

            .page-heading a {
                display: inline-block;
                margin-bottom: 1rem;
                font-weight: 600;
                font-size: 0.95rem;
            }

            .page-heading h1 {
                font-weight: 700;
                font-size: 2.25rem;
                margin-bottom: 0.5rem;
                color: #222;
            }

        .muted {
            color: #666666;
            font-size: 1rem;
            margin-top: 0.25rem;
        }

        .form-panel {
            max-width: 480px;
            background: #fff;
            margin: 0 auto 4rem;
            padding: 2rem 2.5rem;
            border-radius: 8px;
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
        }

        label {
            display: block;
            margin-bottom: 0.35rem;
            font-weight: 600;
            color: #444;
        }

        input[type="text"],
        input[type="email"],
        input[type="password"],
        select {
            width: 100%;
            padding: 0.55rem 0.75rem;
            border: 1.8px solid #ccc;
            border-radius: 6px;
            font-size: 1rem;
            transition: border-color 0.25s ease-in-out, box-shadow 0.25s ease-in-out;
            box-sizing: border-box;
        }

        input[readonly] {
            background-color: #e9ecef;
            cursor: default;
            color: #555;
        }

        select:focus,
        input[type="text"]:focus,
        input[type="email"]:focus,
        input[type="password"]:focus {
            border-color: #0078d7;
            box-shadow: 0 0 6px rgba(0, 120, 215, 0.3);
            outline: none;
            background-color: white;
        }

        small.muted {
            font-size: 0.9rem;
            color: #555;
            margin-top: -0.65rem;
            margin-bottom: 1rem;
            display: block;
        }

        .validation {
            background-color: #ffefef;
            color: #b00000;
            border: 1px solid #b00000;
            padding: 1rem;
            border-radius: 6px;
            margin-bottom: 1rem;
            font-weight: 600;
            box-sizing: border-box;
        }

        .notice {
            background-color: #e2f0d9;
            border: 1px solid #a6d785;
            color: #33691e;
            padding: 1rem;
            border-radius: 6px;
            font-weight: 600;
            margin-bottom: 1rem;
        }

        .form-actions {
            margin-top: 1.5rem;
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            align-items: center;
        }

        button.button {
            background-color: #0078d7;
            color: white;
            padding: 0.75rem 1.8rem;
            border: none;
            border-radius: 6px;
            font-weight: 700;
            font-size: 1.1rem;
            cursor: pointer;
            transition: background-color 0.3s ease;
            user-select: none;
        }

            button.button:hover,
            button.button:focus {
                background-color: #005a9e;
                outline: none;
            }

        .form-actions a.button {
            display: inline-block;
            background-color: #e6f0fa;
            color: #0078d7;
            padding: 0.75rem 1rem;
            border-radius: 6px;
            font-weight: 600;
            text-align: center;
            transition: background-color 0.3s ease;
        }

            .form-actions a.button:hover,
            .form-actions a.button:focus {
                background-color: #c0dafd;
                outline: none;
            }

        p.muted, p.notice {
            margin-top: 0;
            margin-bottom: 1rem;
        }
        /* Responsive */
        @@media (max-width: 520px) {
            .form-panel

        {
            margin: 1rem;
            padding: 1.5rem 2rem;
        }

        .page-heading h1 {
            font-size: 1.75rem;
        }

        button.button {
            font-size: 1rem;
            width: 100%;
        }

        .form-actions {
            flex-direction: column;
            align-items: stretch;
        }

            .form-actions a.button {
                width: 100%;
            }

        }</style>
</head>
<body>
    <div class="page-heading">
        <div>
            <a asp-controller="@backController"
               asp-action="@backAction"
               asp-route-clients="@(!Model.Staff)">← Back to accounts</a>
            <h1>@ViewData["Title"]</h1>
            <p class="muted">
                @(Model.SelectedUser is null
                                ? "Choose a directory user to enable their sign-in."
                                : "The selected person and account type are fixed to their directory record.")
            </p>
        </div>
    </div>

    @if (Model.SelectedUser is null)
    {
        <form asp-action="Create" method="get" class="panel form-panel" novalidate>
            <input name="staff" value="@Model.Staff" type="hidden" />

            <label for="userId">@(Model.Staff ? "Agent" : "Customer user")</label>
            <select id="userId" name="userId" required>
                <option value="">Select a user</option>
                @foreach (var person in Model.Users)
                {
                    <option value="@person.Id">@person.Name · @person.Email</option>
                }
            </select>

            <p class="muted">
                Account type: <strong>@(Model.Staff ? "Agent" : "Customer user")</strong>
            </p>

            @if (Model.Users.Any())
            {
                <div class="form-actions">
                    <button type="submit" class="button">Continue</button>
                </div>
            }
            else
            {
                <p class="muted">All users in this group already have sign-in accounts.</p>
            }

            <p>
                <a asp-controller="@(User.IsInRole("Admin") ? "Users" : "MyWork")"
                   asp-action="@(User.IsInRole("Admin") ? "Create" : "CreateClient")"
                   asp-route-staff="@Model.Staff">
                    @(Model.Staff ? "Add agent" : "Add a customer user")
                </a>
            </p>
        </form>
    }
    else
    {
        <form asp-action="Create"
              asp-route-userId="@Model.SelectedUser.Id"
              method="post"
              class="panel form-panel"
              novalidate>
            <input asp-for="DeskUserId" type="hidden" />
            <div asp-validation-summary="All" class="validation" role="alert"></div>

            <label for="selectedUserName">@(Model.Staff ? "Agent" : "Customer user")</label>
            <input id="selectedUserName" value="@Model.SelectedUser.Name" readonly />

            <label for="selectedUserEmail">Email address</label>
            <input id="selectedUserEmail" value="@Model.SelectedUser.Email" readonly />

            <label for="fixedAccountType">Account type</label>
            <input id="fixedAccountType"
                   value="@(Model.Staff ? "Agent" : "Customer user")"
                   readonly
                   aria-describedby="fixedAccountNote" />
            <small id="fixedAccountNote" class="muted">
                Automatically determined from this person's saved user group. It cannot be changed here.
            </small>

            @if (!Model.Staff)
            {
                <label for="selectedUserCustomer">Customer</label>
                <input id="selectedUserCustomer" value="@Model.SelectedUser.Client?.Name" readonly />
            }

            @if (Model.AlreadyEnabled)
            {
                <p class="notice" role="status">Sign-in is already enabled for this user or email.</p>
                <div class="form-actions">
                    <a class="button"
                       asp-controller="@backController"
                       asp-action="@backAction"
                       asp-route-clients="@(!Model.Staff)">View sign-in accounts</a>
                </div>
            }
            else
            {
                <label asp-for="Password">Initial password</label>
                <input asp-for="Password"
                       type="password"
                       minlength="8"
                       maxlength="128"
                       autocomplete="new-password"
                       required />
                <small class="muted">Use at least 8 characters.</small>

                <label asp-for="ConfirmPassword">Confirm password</label>
                <input asp-for="ConfirmPassword"
                       type="password"
                       minlength="8"
                       maxlength="128"
                       autocomplete="new-password"
                       required />

                <div class="form-actions">
                    <button class="button" type="submit">Create sign-in account</button>
                    <a asp-controller="@backController"
                       asp-action="@backAction"
                       asp-route-clients="@(!Model.Staff)">Cancel</a>
                </div>
            }
        </form>
    }
</body>
</html>
