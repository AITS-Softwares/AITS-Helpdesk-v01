@model ProvisionAccountViewModel
@{ ViewData["Title"] = "Enable user sign-in"; }
<div class="page-heading"><div><a asp-action="Index">← Back to accounts</a><h1>Enable user sign-in</h1><p class="muted">Create access for an existing directory user. The sign-in role follows their user type.</p></div></div>
<form asp-action="Create" method="post" class="panel form-panel"><div asp-validation-summary="All" class="validation" role="alert"></div><label asp-for="DeskUserId">Directory user</label><select asp-for="DeskUserId" required><option value="">Select a user</option>@foreach (var person in Model.Users) { <option value="@person.Id">@person.Name · @person.Email · @(person.UserType == UserType.AitsStaff ? "AITS staff" : "Client user")</option> }</select><p class="muted">Missing someone? <a asp-controller="Users" asp-action="Create">Add a directory user first</a>.</p><label asp-for="Password">Initial password</label><input asp-for="Password" type="password" minlength="12" maxlength="128" autocomplete="new-password" required /><label asp-for="ConfirmPassword">Confirm password</label><input asp-for="ConfirmPassword" type="password" minlength="12" maxlength="128" autocomplete="new-password" required /><div class="form-actions"><button class="button" type="submit">Create sign-in account</button><a asp-action="Index">Cancel</a></div></form>
