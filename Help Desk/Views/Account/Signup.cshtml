@model SignupViewModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Client sign up"; }
<p class="eyebrow">CLIENT REGISTRATION</p><h2>Create your account</h2><p class="muted">Select your company to get started. Companies are created by an AITS admin.</p>
<form asp-action="Signup" method="post"><div asp-validation-summary="All" class="validation" role="alert"></div><label asp-for="Name">Full name</label><input asp-for="Name" maxlength="80" autocomplete="name" required /><label asp-for="Email">Work email</label><input asp-for="Email" type="email" maxlength="160" autocomplete="username" required /><label asp-for="ClientId">Company</label><select asp-for="ClientId" required><option value="">Select your company</option>@foreach (var company in Model.Companies) { <option value="@company.Id">@company.Name</option> }</select><label asp-for="Department"></label><input asp-for="Department" maxlength="80" required /><label asp-for="Password"></label><input asp-for="Password" type="password" autocomplete="new-password" minlength="8" maxlength="128" required /><small class="muted">Use at least 8 characters.</small><label asp-for="ConfirmPassword">Confirm password</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="128" required /><button class="button auth-submit" type="submit">Create client account</button></form><p class="auth-link">Already registered? <a asp-action="Login">Sign in</a></p>

<p class="auth-link">An AITS team member? <a asp-action="AitsSignup">AITS sign up</a></p>
