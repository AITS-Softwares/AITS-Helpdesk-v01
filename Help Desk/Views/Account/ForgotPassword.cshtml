@model ForgotPasswordViewModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Forgot password"; }
<p class="eyebrow">ACCOUNT RECOVERY</p><h2>Forgot your password?</h2>
<p class="muted">Enter your sign-in email to request an Admin-assisted password reset. Your Admin will verify your identity before setting a new password.</p>
<form asp-action="ForgotPassword" method="post">
    <input asp-for="LoginArea" type="hidden" />
    <div asp-validation-summary="All" class="validation" role="alert"></div>
    <label asp-for="Email">Sign-in email address</label><input asp-for="Email" type="email" maxlength="160" autocomplete="username" required />
    <button class="button auth-submit" type="submit">Request password reset</button>
</form>
<p class="auth-link"><a asp-action="@(Model.LoginArea == LoginArea.Aits ? "AitsLogin" : "Login")">Back to sign in</a></p>
<p class="setup-link muted">If you are an Admin who cannot sign in, contact another Admin or your system maintainer for help.</p>
