@model ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot password";
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700&family=Figtree:wght@400;500;600&display=swap" />

<style>
    .aits-forgot {
        --ink: #14263a;
        --ink-soft: #c9d6e2;
        --teal: #0f7b8a;
        --teal-dark: #0b5f6b;
        --tint: #e4f1f0;
        --signal: #f2b544;
        --page: #eef2f5;
        --surface: #ffffff;
        --text: #1b2733;
        --muted: #5b6b7a;
        --line: #d5dde4;
        --danger: #b3261e;
        font-family: "Figtree", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        color: var(--text);
        background: var(--page);
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: clamp(1rem, 4vw, 3rem);
        box-sizing: border-box;
    }

        .aits-forgot *,
        .aits-forgot *::before,
        .aits-forgot *::after {
            box-sizing: border-box;
        }

    .aits-card {
        width: 100%;
        max-width: 30rem;
        background: var(--surface);
        border-radius: 1.25rem;
        overflow: hidden;
        box-shadow: 0 1px 2px rgba(20, 38, 58, 0.06), 0 12px 32px rgba(20, 38, 58, 0.1);
    }

    /* ---------- Header band ---------- */
    .aits-head {
        background: var(--ink);
        color: #fff;
        padding: clamp(1.5rem, 5vw, 2.25rem);
    }

        .aits-head h2 {
            font-family: "Bricolage Grotesque", "Figtree", system-ui, sans-serif;
            font-size: clamp(1.5rem, 5vw, 1.9rem);
            line-height: 1.15;
            margin: 0 0 0.5rem;
            letter-spacing: -0.01em;
        }

        .aits-head p {
            margin: 0;
            color: var(--ink-soft);
            line-height: 1.55;
        }

    /* ---------- Body ---------- */
    .aits-body {
        padding: clamp(1.5rem, 5vw, 2.25rem);
    }

    .aits-steps {
        list-style: none;
        margin: 0 0 1.5rem;
        padding: 0;
        display: grid;
        gap: 0.6rem;
    }

        .aits-steps li {
            display: grid;
            grid-template-columns: 1.6rem 1fr;
            column-gap: 0.7rem;
            align-items: start;
            font-size: 0.92rem;
            line-height: 1.45;
            color: var(--muted);
        }

    .aits-step-dot {
        width: 1.6rem;
        height: 1.6rem;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-size: 0.8rem;
        font-weight: 600;
        background: var(--tint);
        color: var(--teal-dark);
    }

    .aits-steps li.is-current .aits-step-dot {
        background: var(--signal);
        color: var(--ink);
    }

    .aits-steps li.is-current {
        color: var(--ink);
        font-weight: 600;
    }

    .aits-form {
        display: grid;
        gap: 1rem;
    }

    .aits-field {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

        .aits-field label {
            font-weight: 600;
            font-size: 0.92rem;
            color: var(--ink);
        }

        .aits-field input {
            width: 100%;
            font: inherit;
            color: var(--text);
            background: #fff;
            border: 1.5px solid var(--line);
            border-radius: 0.6rem;
            padding: 0.7rem 0.85rem;
            min-height: 2.9rem;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

            .aits-field input:hover {
                border-color: #b4c1cc;
            }

            .aits-field input:focus-visible {
                outline: none;
                border-color: var(--teal);
                box-shadow: 0 0 0 3px rgba(15, 123, 138, 0.22);
            }

            .aits-field input.input-validation-error {
                border-color: var(--danger);
            }

        .aits-field .field-validation-error {
            color: var(--danger);
            font-size: 0.85rem;
        }

    .aits-body .validation {
        background: #fdecea;
        border: 1px solid #f3c1bd;
        color: var(--danger);
        border-radius: 0.6rem;
        padding: 0.75rem 1rem;
        font-size: 0.92rem;
    }

        .aits-body .validation.validation-summary-valid,
        .aits-body .validation:empty {
            display: none;
        }

        .aits-body .validation ul {
            margin: 0;
            padding-left: 1.1rem;
        }

    .aits-submit {
        margin-top: 0.2rem;
        font: inherit;
        font-weight: 600;
        font-size: 1rem;
        color: #fff;
        background: var(--teal);
        border: 0;
        border-radius: 0.65rem;
        min-height: 3rem;
        padding: 0.75rem 1.25rem;
        cursor: pointer;
        transition: background 0.15s, transform 0.05s;
    }

        .aits-submit:hover {
            background: var(--teal-dark);
        }

        .aits-submit:active {
            transform: translateY(1px);
        }

        .aits-submit:focus-visible {
            outline: 3px solid var(--signal);
            outline-offset: 2px;
        }

    .aits-back {
        margin: 1.5rem 0 0;
        padding-top: 1.1rem;
        border-top: 1px solid var(--line);
        font-size: 0.92rem;
    }

        .aits-back a {
            color: var(--teal-dark);
            font-weight: 600;
            text-underline-offset: 3px;
        }

            .aits-back a:focus-visible {
                outline: 2px solid var(--signal);
                outline-offset: 2px;
                border-radius: 2px;
            }

    .aits-note {
        margin: 0.9rem 0 0;
        font-size: 0.85rem;
        line-height: 1.5;
        color: var(--muted);
    }

    /* ---------- Responsive ---------- */
    @@media (max-width: 30rem) {
        .aits-forgot {
            padding: 0.75rem;
            align-items: start;
        }

        .aits-card {
            border-radius: 1rem;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .aits-forgot * {
            transition: none !important;
        }
    }
</style>

<div class="aits-forgot">
    <div class="aits-card">

        <header class="aits-head">
            <h2>Forgot your password?</h2>
            <p>Enter your sign-in email to request a password reset. Your Admin will verify your identity before setting a new password.</p>
        </header>

        <main class="aits-body">
            <ol class="aits-steps">
                <li class="is-current"><span class="aits-step-dot">1</span><span>Request a reset with your email</span></li>
                <li><span class="aits-step-dot">2</span><span>Your Admin verifies your identity</span></li>
                <li><span class="aits-step-dot">3</span><span>Your Admin sets a new password for you</span></li>
            </ol>

            <form asp-action="ForgotPassword" method="post" class="aits-form" novalidate>
                <input asp-for="LoginArea" type="hidden" />
                <div asp-validation-summary="All" class="validation" role="alert"></div>

                <div class="aits-field">
                    <label asp-for="Email">Sign-in email address</label>
                    <input asp-for="Email" type="email" maxlength="160" autocomplete="username" required />
                    <span asp-validation-for="Email"></span>
                </div>

                <button class="aits-submit" type="submit">Request password reset</button>
            </form>

            <p class="aits-back"><a asp-action="@(Model.LoginArea == LoginArea.Aits ? "AitsLogin" : "Login")">Back to sign in</a></p>

            <p class="aits-note">If you are an Admin who cannot sign in, contact another Admin or your system maintainer for help.</p>
        </main>

    </div>
</div>