@model SetupAdminViewModel
@{
    ViewData["Title"] = "Add administrator";
}

<div class="page-heading">
    <div>
        <a asp-action="Index">← Back to accounts</a>
        <p class="eyebrow">SIGN-IN ACCOUNTS</p>
        <h1>Add administrator</h1>
        <p class="muted">Create an internal admin account. The user can sign in through AITS sign in.</p>
    </div>
</div>

<form asp-action="CreateAdmin" method="post" class="panel form-panel admin-create-form">
    <div asp-validation-summary="All" class="validation" role="alert"></div>

    <label asp-for="Name">Admin name</label>
    <input asp-for="Name" maxlength="80" required autocomplete="name" />
    <span asp-validation-for="Name" class="validation"></span>

    <label asp-for="Email"></label>
    <input asp-for="Email" type="email" maxlength="160" required autocomplete="username" />
    <span asp-validation-for="Email" class="validation"></span>

    <label asp-for="Password"></label>
    <input asp-for="Password" type="password" minlength="8" maxlength="128" required autocomplete="new-password" />
    <small class="muted">Use at least 8 characters.</small>
    <span asp-validation-for="Password" class="validation"></span>

    <label asp-for="ConfirmPassword">Confirm password</label>
    <input asp-for="ConfirmPassword" type="password" minlength="8" maxlength="128" required autocomplete="new-password" />
    <span asp-validation-for="ConfirmPassword" class="validation"></span>

    <div class="form-actions">
        <button class="button" type="submit">Create administrator</button>
        <a asp-action="Index">Cancel</a>
    </div>
</form>
