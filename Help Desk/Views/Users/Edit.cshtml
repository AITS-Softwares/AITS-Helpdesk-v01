@model UserEditViewModel
@{ ViewData["Title"] = Model.UserType == UserType.AitsStaff ? (Model.Id == 0 ? "Add AITS staff" : "Edit AITS staff") : (Model.Id == 0 ? "Add client user" : "Edit client user"); }
<div class="page-heading"><div><a asp-action="@(Model.UserType == UserType.AitsStaff ? "AitsStaff" : "ClientUsers")" asp-route-clientId="@Model.ClientId">← Back to @(Model.UserType == UserType.AitsStaff ? "AITS staff" : "client users")</a><h1>@ViewData["Title"]</h1><p class="muted">Add contact details for ticket requests and assignments.</p></div></div><form asp-action="Save" method="post" class="panel form-panel"><input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="validation"></div><input asp-for="UserType" type="hidden" id="userType" /><label>User group</label><input value="@(Model.UserType == UserType.AitsStaff ? "AITS staff" : "Client user")" readonly />@if (Model.Id == 0 && Model.UserType == UserType.ClientUser) { <div><label asp-for="ClientId">Company</label><p class="muted">Choose the client company this user belongs to. <a asp-controller="Clients" asp-action="Create">Add a company</a></p><select asp-for="ClientId" required><option value="">Select a company</option>@foreach (var client in (List<Client>)ViewBag.Clients) { <option value="@client.Id">@client.Name</option> }</select></div> }<label asp-for="Name">Full name</label><input asp-for="Name" maxlength="80" /><label asp-for="Email"></label><input asp-for="Email" type="email" maxlength="160" /><label asp-for="Department"></label><input asp-for="Department" maxlength="80" /><div class="form-actions"><button class="button" type="submit">Save user</button><a asp-action="@(Model.UserType == UserType.AitsStaff ? "AitsStaff" : "ClientUsers")" asp-route-clientId="@Model.ClientId">Cancel</a></div></form>
