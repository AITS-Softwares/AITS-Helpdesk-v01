@model DeskUser
@{ ViewData["Title"] = Model.Id == 0 ? "Add user" : "Edit user"; }
<div class="page-heading"><div><a asp-action="Index">← Back to users</a><h1>@ViewData["Title"]</h1><p class="muted">Add contact details for ticket requests and assignments.</p></div></div><form asp-action="Save" method="post" class="panel form-panel"><input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="validation"></div><label asp-for="UserType">User type</label><select asp-for="UserType" asp-items="Html.GetEnumSelectList<UserType>()" id="userType"></select><div id="clientMembership"><label asp-for="ClientId">Company</label><p class="muted">Choose the client company this user belongs to. <a asp-controller="Clients" asp-action="Create">Add a company</a></p><select asp-for="ClientId"><option value="">Select a company</option>@foreach (var client in (List<Client>)ViewBag.Clients) { <option value="@client.Id">@client.Name</option> }</select></div><label asp-for="Name">Full name</label><input asp-for="Name" maxlength="80" /><label asp-for="Email"></label><input asp-for="Email" type="email" maxlength="160" /><label asp-for="Department"></label><input asp-for="Department" maxlength="80" /><div class="form-actions"><button class="button" type="submit">Save user</button><a asp-action="Index">Cancel</a></div></form>
@section Scripts { <script>const kind=document.getElementById('userType'); function toggleClient(){const staff=kind.value==='1';document.getElementById('clientMembership').hidden=staff;document.getElementById('ClientId').required=!staff;document.getElementById('ClientId').disabled=staff;}kind.addEventListener('change',toggleClient);toggleClient();</script> }