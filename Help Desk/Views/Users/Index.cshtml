@model List<DeskUser>
@{ ViewData["Title"] = "Users"; }
<div class="page-heading"><div><p class="eyebrow">YOUR WORKSPACE DIRECTORY</p><h1>Users <span class="count">@Model.Count</span></h1><p class="muted">The people behind every request and resolution.</p></div><a class="button" asp-action="Create">+ Add user</a></div><section class="panel"><form method="get" class="filters"><select name="clientId" aria-label="Client company"><option value="">All companies and AITS staff</option>@foreach (var client in (List<Client>)ViewBag.Clients) { <option value="@client.Id" selected="@(ViewBag.ClientId == client.Id)">@client.Name</option> }</select><button class="button">Filter</button><a asp-action="Index">Reset</a></form><div class="table-scroll"><table><thead><tr><th>Name</th><th>Email</th><th>Department</th><th>Company / type</th><th></th></tr></thead><tbody>@foreach (var user in Model) { <tr><td><strong>@user.Name</strong></td><td>@user.Email</td><td>@user.Department</td><td>@(user.UserType == UserType.AitsStaff ? "AITS staff" : ((List<Client>)ViewBag.Clients).Find(c => c.Id == user.ClientId)?.Name)</td><td><a asp-action="Edit" asp-route-id="@user.Id">Edit →</a> · <a asp-action="Delete" asp-route-id="@user.Id">Delete</a> · <a asp-controller="Account" asp-action="Create" asp-route-userId="@user.Id">Enable sign-in</a></td></tr> }</tbody></table></div>@if (!Model.Any()) { <div class="empty">Add a person to start creating and assigning tickets.</div> }</section>