@model DeskUser
@{
    var isAgent = Model.UserType == UserType.AitsStaff;
    var account = ViewBag.SignInAccount as DeskAccount;
    var tickets = (List<UserTicketSummary>)ViewBag.Tickets;
    var assignedCustomerIds = (HashSet<int>)ViewBag.AssignedCustomerIds;
    var assignmentCustomers = (List<Client>)ViewBag.AssignmentCustomers;
    var accountState = account is null ? "Not enabled" : !account.IsActive ? "Inactive" : !account.IsApproved ? "Pending approval" : "Active";
    ViewData["Title"] = Model.Name;
}
<style>
    .user-detail-hero-actions{display:flex;align-items:center;justify-content:flex-end;gap:9px;flex-wrap:wrap}
    .user-detail-hero-actions .user-detail-state{margin-right:4px}
    .user-detail-hero-actions .button{white-space:nowrap}
    .user-detail-assignment-editor{overflow:hidden}
    .user-detail-assignment-editor>.user-detail-section-heading{border-bottom:1px solid #eceef4}
    .user-detail-assignment-intro{margin:0;padding:14px 20px 0;color:#708096;font-size:13px}
    .user-detail-assignment-form{display:grid;gap:15px;padding:16px 20px 20px}
    .user-detail-assignment-list-card{margin:0;padding:14px;border:1px solid #e3e6ee;border-radius:13px;background:linear-gradient(150deg,#fff,#f8f7ff)}
    .user-detail-assignment-list-card legend{display:flex;align-items:center;gap:8px;width:100%;padding:0 3px 10px;color:#26344b;font-size:14px;font-weight:750}
    .user-detail-assignment-list-card legend small{margin-left:auto;padding:4px 8px;border-radius:999px;background:#fff;color:#748196;font-size:11px;font-weight:600}
    .user-detail-assignment-list{display:grid;gap:5px;max-height:230px;overflow:auto}
    .user-detail-assignment-option{display:flex;align-items:center;gap:9px;margin:0;padding:8px;border:1px solid #e8eaf0;border-radius:8px;background:#ffffffdb;color:#2b3850;font-size:12px;font-weight:600;cursor:pointer}
    .user-detail-assignment-option:hover{border-color:color-mix(in srgb,var(--assignment-accent) 34%,white);background:#fff}
    .user-detail-assignment-option input{width:16px;height:16px;margin:0;accent-color:#6857d6}
    .user-detail-assignment-option span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .user-detail-assignment-empty{padding:12px;color:#7c899a;font-size:12px}
    .user-detail-assignment-actions{display:flex;justify-content:flex-end;align-items:center;gap:12px}
    .user-detail-assignment-actions small{margin-right:auto;color:#748196;font-size:11px}
    @@media(max-width:760px){.user-detail-assignment-list{max-height:280px}}
    @@media(max-width:760px){.user-detail-hero-actions{justify-content:flex-start}.user-detail-hero-actions .user-detail-state{margin-right:auto}}
</style>

<div class="user-detail-page">
    <a class="user-detail-back" asp-controller="Account" asp-action="Index" asp-route-clients="@(!isAgent)"><span aria-hidden="true">←</span> Back to accounts</a>

    <header class="user-detail-hero">
        <div class="user-detail-identity">
            <span class="user-detail-eyebrow">@(isAgent ? "AITS AGENT" : "CUSTOMER USER")</span>
            <h1>@Model.Name</h1>
            <a class="user-detail-email" href="mailto:@Model.Email">@Model.Email</a>
            <div class="user-detail-meta"><span>@Model.Department</span>@if (!isAgent && Model.Client is not null) { <span><a asp-controller="Clients" asp-action="Details" asp-route-id="@Model.ClientId">@Model.Client.Name</a></span> }</div>
        </div>
        <div class="user-detail-hero-actions">
            <span class="user-detail-state @(accountState == "Active" ? "is-active" : accountState == "Inactive" ? "is-inactive" : "is-pending")"><i></i>@accountState</span>
            @if (isAgent) { <a class="button button-secondary action-control" href="#agent-assignments"><span>Assign Customers</span></a> }
            <a class="button button-secondary action-control" asp-action="Edit" asp-route-id="@Model.Id"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg><span>Edit profile</span></a>
        </div>
    </header>

    <div class="user-detail-stats @(isAgent ? "is-agent" : "")">
        <article class="user-detail-stat is-violet"><span class="user-detail-stat-icon" aria-hidden="true">▤</span><div><strong>@tickets.Count</strong><small>@(isAgent ? "Assigned tickets" : "Tickets submitted")</small></div></article>
        @if (isAgent) {
            <article class="user-detail-stat is-teal"><span class="user-detail-stat-icon" aria-hidden="true">✓</span><div><strong>@accountState</strong><small>Sign-in status</small></div></article>
        } else {
            <article class="user-detail-stat is-teal"><span class="user-detail-stat-icon" aria-hidden="true">◉</span><div><strong>@(Model.Client is null ? "—" : "1")</strong><small>Customer account</small></div></article>
            <article class="user-detail-stat is-blue"><span class="user-detail-stat-icon" aria-hidden="true">✓</span><div><strong>@accountState</strong><small>Sign-in status</small></div></article>
        }
    </div>

    <section class="user-detail-card user-detail-profile">
        <div class="user-detail-section-heading"><span class="user-detail-section-icon" aria-hidden="true">◎</span><div><h2>Profile information</h2><p>Contact and account details</p></div></div>
        <dl class="user-detail-fields">
            <div><dt>Full name</dt><dd>@Model.Name</dd></div>
            <div><dt>Email address</dt><dd><a href="mailto:@Model.Email">@Model.Email</a></dd></div>
            <div><dt>Department</dt><dd>@Model.Department</dd></div>
            <div><dt>Account status</dt><dd><span class="user-detail-state is-inline @(accountState == "Active" ? "is-active" : accountState == "Inactive" ? "is-inactive" : "is-pending")"><i></i>@accountState</span></dd></div>
            @if (!isAgent) { <div><dt>Customer</dt><dd>@if (Model.Client is null) { <span class="muted">Not assigned</span> } else { <a asp-controller="Clients" asp-action="Details" asp-route-id="@Model.ClientId">@Model.Client.Name <span aria-hidden="true">↗</span></a> }</dd></div> }
        </dl>
    </section>

    @if (isAgent) {
        <section id="agent-assignments" class="user-detail-card user-detail-assignment-editor">
            <div class="user-detail-section-heading"><span class="user-detail-section-icon is-teal" aria-hidden="true">▦</span><div><h2>Assign Customers</h2><p>Select the customers and support level for this agent</p></div></div>
            <p class="user-detail-assignment-intro">Choose customers in the level lists below. Each customer can be assigned to one level for this agent.</p>
            <form asp-action="AssignCustomers" asp-route-id="@Model.Id" asp-route-returnToDetails="true" method="post" class="user-detail-assignment-form">
                <div asp-validation-summary="All" class="validation" role="alert"></div>
                <fieldset class="user-detail-assignment-list-card">
                    <legend><span>Customers</span><small data-assigned-count>@assignedCustomerIds.Count selected</small></legend>
                    @if (assignmentCustomers.Count == 0) { <p class="user-detail-assignment-empty">No customers available.</p> }
                    else {
                        <div class="user-detail-assignment-list">
                            @foreach (var customer in assignmentCustomers) {
                                <label class="user-detail-assignment-option"><input type="checkbox" name="SelectedClientIds" value="@customer.Id" checked="@assignedCustomerIds.Contains(customer.Id)" /><span title="@customer.Name">@customer.Name</span></label>
                            }
                        </div>
                    }
                </fieldset>
                <div class="user-detail-assignment-actions"><small>New assignments use Frontline (L1); current support levels are preserved.</small><button type="submit" class="button">Save assignments</button></div>
            </form>
        </section>
    }

    <section class="user-detail-card user-detail-tickets">
        <div class="user-detail-section-heading"><span class="user-detail-section-icon is-blue" aria-hidden="true">▤</span><div><h2>@(isAgent ? "Assigned tickets" : "Customer tickets")</h2><p>Recent ticket activity for @Model.Name</p></div><span class="user-detail-ticket-count">@tickets.Count</span></div>
        @if (tickets.Count == 0) { <div class="user-detail-empty-state"><span aria-hidden="true">▤</span><strong>No tickets yet</strong><p>Tickets related to this account will appear here.</p></div> }
        else { <div class="user-detail-ticket-list">@foreach (var ticket in tickets) { <a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id" class="user-detail-ticket-row"><span class="user-detail-ticket-number">#@ticket.Id.ToString("D4")</span><span class="user-detail-ticket-title"><strong>@ticket.Title</strong><small>Updated @ticket.UpdatedAt.ToString("dd MMM yyyy, HH:mm") UTC</small></span><span class="badge @ticket.Status">@ticket.Status</span><span class="user-detail-ticket-arrow" aria-hidden="true">→</span></a> }</div> }
    </section>
</div>
<script>
    (() => {
        const count = document.querySelector('[data-assigned-count]');
        const list = document.querySelector('.user-detail-assignment-list');
        if (!count || !list) return;
        const update = () => count.textContent = `${list.querySelectorAll('input:checked').length} selected`;
        list.addEventListener('change', update);
    })();
</script>
