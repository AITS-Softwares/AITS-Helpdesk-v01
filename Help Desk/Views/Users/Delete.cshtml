@model DeskUser
@{ ViewData["Title"] = "Confirm deletion"; }
<div class="page-heading"><div><a asp-action="@(Model.UserType == UserType.AitsStaff ? "AitsStaff" : "ClientUsers")" asp-route-clientId="@Model.ClientId">← Back</a><h1>Confirm deletion</h1></div></div>
<section class="panel detail-panel"><h2>Delete @Model.Name?</h2><p>Users referenced by tickets cannot be deleted.</p><form asp-action="Delete" method="post"><input asp-for="Id" type="hidden" /><div class="form-actions"><button type="submit" class="button danger">Delete permanently</button><a asp-action="@(Model.UserType == UserType.AitsStaff ? "AitsStaff" : "ClientUsers")" asp-route-clientId="@Model.ClientId">Cancel</a></div></form></section>
