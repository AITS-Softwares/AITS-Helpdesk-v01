@model DeskData
@{ ViewData["Title"] = "Overview"; var active = Model.Tickets.Count(t => t.Status == TicketStatus.Open || t.Status == TicketStatus.InProgress); }
<div class="page-heading"><div><p class="eyebrow">YOUR SUPPORT, AT A GLANCE</p><h1>@(User.IsInRole("ClientUser") ? "Your support overview" : "AITS support overview")</h1><p class="muted">@(User.IsInRole("ClientUser") ? "Track your requests and get help from AITS." : $"Supporting {Model.Clients.Count} client companies from one workspace.")</p></div><a class="button" asp-controller="Tickets" asp-action="Create">+ New ticket</a></div>
<div class="stats"><div class="stat"><span>Total tickets</span><strong>@Model.Tickets.Count</strong><small>Every request, in one place</small></div><div class="stat"><span>Active requests</span><strong>@active</strong><small>Open and in progress</small></div><div class="stat"><span>Resolved & closed</span><strong>@Model.Tickets.Count(t => t.Status == TicketStatus.Resolved || t.Status == TicketStatus.Closed)</strong><small>Moving work forward</small></div><div class="stat"><span>Urgent & active</span><strong>@Model.Tickets.Count(t => t.Priority == TicketPriority.Urgent && (t.Status == TicketStatus.Open || t.Status == TicketStatus.InProgress))</strong><small>Needs your attention</small></div></div>
<div class="overview-grid"><section class="panel"><div class="panel-heading"><div><h2>Recent tickets</h2><p class="muted">The latest activity across your workspace</p></div><a asp-controller="Tickets" asp-action="Index">View all →</a></div>@if (!Model.Tickets.Any()) { <div class="empty">No tickets yet. Create your first request to get started.</div> } else { @foreach (var ticket in Model.Tickets.OrderByDescending(t => t.UpdatedAt).Take(6)) { <a class="ticket-row" asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id"><span class="ticket-number">#@ticket.Id.ToString("D4")</span><span class="ticket-summary"><strong>@ticket.Title</strong><small>@(Model.Users.Find(u => u.Id == ticket.RequesterId)?.Name) · @ticket.UpdatedAt.ToString("dd MMM, HH:mm")</small></span><span class="badge @ticket.Status">@ticket.Status</span></a> } }</section><section class="panel"><div class="panel-heading"><h2>Ticket breakdown</h2></div><div class="breakdown">@foreach (var status in Enum.GetValues<TicketStatus>()) { var count = Model.Tickets.Count(t => t.Status == status); <div class="breakdown-label"><span>@status</span><strong>@count</strong></div><progress value="@count" max="@Math.Max(1, Model.Tickets.Count)"></progress> }<div class="team-note"><strong>@Model.Users.Count people, one team.</strong><p class="muted">Connect requests with the right person.</p>@if (User.IsInRole("Admin")) { <a asp-controller="Users" asp-action="Index">Manage people →</a> }</div></div></section></div>