@model EmailSettingsViewModel
@{ ViewData["Title"] = "Email settings"; }
<div class="page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h1>Email settings</h1><p class="muted">Choose the email account used to send ticket notifications to the assigned project teams.</p></div><span class="badge @(Model.Enabled ? "status-active" : "status-inactive")">@(Model.Enabled ? "Sending enabled" : "Sending disabled")</span></div>
<form asp-action="Index" method="post" class="panel form-panel"><div asp-validation-summary="All" class="validation" role="alert"></div>
<label class="project-choice"><input asp-for="Enabled" /> Enable ticket email notifications</label>
<label asp-for="UserName">Email account</label><input asp-for="UserName" type="email" placeholder="yourcompany@gmail.com" autocomplete="off" required /><small>The email address used to sign in to your mail provider.</small>
<div class="form-grid"><div><label asp-for="FromAddress">Sender email</label><input asp-for="FromAddress" type="email" required /></div><div><label asp-for="FromName">Sender name</label><input asp-for="FromName" required maxlength="100" /></div></div>
<label asp-for="Password">App password @(Model.HasPassword ? "(already saved)" : "")</label><input asp-for="Password" type="password" autocomplete="new-password" maxlength="256" /><small>@(Model.HasPassword ? "Leave blank to keep the saved password. Enter a new app password to replace it." : "Enter your email provider's app password.") Passwords are encrypted and never displayed here.</small>
<details class="email-advanced"><summary>SMTP and helpdesk link settings</summary><div class="form-grid"><div><label asp-for="Host">SMTP server</label><input asp-for="Host" required /></div><div><label asp-for="Port">SMTP port</label><input asp-for="Port" type="number" min="1" max="65535" required /></div></div><p class="muted">Gmail uses smtp.gmail.com, port 587, with STARTTLS and an app password.</p><label asp-for="PublicBaseUrl">Helpdesk URL (optional)</label><input asp-for="PublicBaseUrl" type="url" placeholder="https://helpdesk.yourcompany.com" /><small>Ticket emails include a link when this is set.</small></details>
<div class="form-actions"><button class="button" type="submit">Save email settings</button></div><p class="muted">New tickets notify the project's L1 team. Saving settings does not send a test email.</p></form>
