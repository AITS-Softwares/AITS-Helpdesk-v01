@model EmailSettingsViewModel
@{
    ViewData["Title"] = "Email Settings";
}
<style>
    .mail-settings-page{max-width:84rem;margin:0 auto;display:grid;gap:22px;font-size:15px}
    .mail-settings-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:2px}
    .mail-settings-heading h1{margin:0;font-size:36px;line-height:1.15;letter-spacing:-.8px;color:var(--ink)}
    .mail-settings-heading p{margin:8px 0 0;color:var(--muted);font-size:16px}
    .mail-settings-status{display:inline-flex;align-items:center;gap:8px;padding:10px 14px;border-radius:999px;font-size:14px;font-weight:700;white-space:nowrap}
    .mail-settings-status:before{content:"";width:8px;height:8px;border-radius:50%;background:currentColor}
    .mail-settings-status.is-on{background:#e7f6ee;color:#16734d}.mail-settings-status.is-off{background:#f0f2f5;color:#667085}
    .mail-settings-form{display:grid;gap:20px;padding:26px}
    .mail-settings-toggle{display:flex;align-items:center;gap:14px;padding:17px 19px;border:1px solid #d8e8e8;border-radius:13px;background:linear-gradient(110deg,#f1fbfa,#f8fbff);color:var(--ink);font-size:16px;font-weight:700}
    .mail-settings-toggle input{width:21px;height:21px;margin:0;accent-color:var(--teal)}
    .mail-settings-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
    .mail-settings-card{min-width:0;padding:24px;border:1px solid var(--line);border-radius:15px;background:#fff;box-shadow:0 5px 22px #21345208}
    .mail-settings-card header{display:flex;align-items:center;gap:13px;margin-bottom:20px}
    .mail-settings-icon{display:grid;place-items:center;width:44px;height:44px;border-radius:12px;background:#eaf5f5;color:var(--teal);font-size:22px}
    .mail-settings-card h2{margin:0;color:var(--ink);font-size:20px}.mail-settings-card header p{margin:4px 0 0;color:var(--muted);font-size:14px}
    .mail-settings-fields{display:grid;gap:16px}.mail-settings-fields label{display:block;margin:0 0 6px;color:var(--ink);font-size:14px;font-weight:650}
    .mail-settings-fields input{width:100%;min-height:46px;padding:10px 12px;border:1px solid #d9dfeb;border-radius:9px;background:#fff;color:var(--ink);font-size:15px}
    .mail-settings-fields input:focus{outline:0;border-color:var(--teal);box-shadow:0 0 0 3px color-mix(in srgb,var(--teal) 16%,transparent)}
    .mail-settings-fields small{display:block;margin-top:6px;color:var(--muted);font-size:13px;line-height:1.5}
    .mail-settings-check{display:flex!important;align-items:center;gap:10px;margin:0!important;padding:12px 14px;border:1px solid var(--line);border-radius:9px;background:#f8fafc;color:var(--ink);font-size:14px!important}
    .mail-settings-check input{width:18px;min-height:18px;margin:0;accent-color:var(--teal)}
    .mail-settings-inline{display:grid;grid-template-columns:minmax(0,1fr) 110px;gap:12px}
    .mail-settings-advanced{padding:13px 15px;border:1px solid var(--line);border-radius:11px;background:#fbfcfe}
    .mail-settings-advanced summary{color:var(--ink);font-size:14px;font-weight:700;cursor:pointer}
    .mail-settings-advanced .mail-settings-fields{margin-top:14px}
    .mail-settings-actions{display:flex;align-items:center;gap:12px;padding-top:2px}
    .mail-settings-actions p{margin:0;color:var(--muted);font-size:13px}
    @@media(max-width:760px){.mail-settings-grid{grid-template-columns:1fr}.mail-settings-heading{align-items:flex-start;flex-direction:column}.mail-settings-heading h1{font-size:30px}}
    @@media(max-width:420px){.mail-settings-inline{grid-template-columns:minmax(0,1fr) 88px}.mail-settings-card,.mail-settings-form{padding:17px}.mail-settings-actions{align-items:flex-start;flex-direction:column}}
</style>

<main class="mail-settings-page">
    <header class="mail-settings-heading">
        <div><h1>Email Settings</h1><p>Configure ticket notifications and incoming support mail.</p></div>
        <span class="mail-settings-status @(Model.Enabled ? "is-on" : "is-off")">@(Model.Enabled ? "Sending enabled" : "Sending disabled")</span>
    </header>

    <form asp-action="Index" method="post" class="panel form-panel mail-settings-form">
        <div asp-validation-summary="All" class="validation" role="alert"></div>

        <label class="mail-settings-toggle"><input asp-for="Enabled" /><span>Send ticket email notifications</span></label>

        <div class="mail-settings-grid">
            <section class="mail-settings-card" aria-labelledby="outgoing-mail-heading">
                <header><span class="mail-settings-icon" aria-hidden="true">↗</span><div><h2 id="outgoing-mail-heading">Outgoing email</h2><p>Mail sent by the help desk</p></div></header>
                <div class="mail-settings-fields">
                    <div><label asp-for="UserName">Mailbox sign-in email</label><input asp-for="UserName" type="email" placeholder="support@company.com" autocomplete="off" required /></div>
                    <div><label asp-for="FromAddress">Sender email</label><input asp-for="FromAddress" type="email" required /></div>
                    <div><label asp-for="FromName">Sender name</label><input asp-for="FromName" required maxlength="100" /></div>
                    <div><label asp-for="Password">Mailbox app password</label><input asp-for="Password" type="password" autocomplete="new-password" maxlength="256" placeholder="@(Model.HasPassword ? "Saved — enter to replace" : "Enter app password")" /><small>@(Model.HasPassword ? "Leave blank to keep the saved password." : "Use an app password from your email provider.") Encrypted when saved.</small></div>
                </div>
            </section>

            <section class="mail-settings-card" aria-labelledby="incoming-mail-heading">
                <header><span class="mail-settings-icon" aria-hidden="true">↙</span><div><h2 id="incoming-mail-heading">Incoming email</h2><p>Customer emails become support tickets</p></div></header>
                <div class="mail-settings-fields">
                    <label class="mail-settings-check"><input asp-for="IncomingEnabled" /><span>Create tickets from customer emails</span></label>
                    <div><label asp-for="SupportAddress">Support email address</label><input asp-for="SupportAddress" type="email" placeholder="support@company.com" /></div>
                    <div class="mail-settings-inline"><div><label asp-for="IncomingHost">IMAP server</label><input asp-for="IncomingHost" placeholder="imap.gmail.com" /></div><div><label asp-for="IncomingPort">Port</label><input asp-for="IncomingPort" type="number" min="1" max="65535" /></div></div>
                    <small>Uses the mailbox and app password above. New messages are checked every 30 seconds.</small>
                </div>
            </section>
        </div>

        <details class="mail-settings-advanced">
            <summary>Advanced connection settings</summary>
            <div class="mail-settings-fields">
                <div class="mail-settings-inline"><div><label asp-for="Host">SMTP server</label><input asp-for="Host" required /></div><div><label asp-for="Port">SMTP port</label><input asp-for="Port" type="number" min="1" max="65535" required /></div></div>
                <div><label asp-for="PublicBaseUrl">Help desk link in emails (optional)</label><input asp-for="PublicBaseUrl" type="url" placeholder="https://helpdesk.company.com" /></div>
            </div>
        </details>

        <div class="mail-settings-actions"><button class="button" type="submit">Save email settings</button><p>Saving settings does not send a test email.</p></div>
    </form>
</main>
