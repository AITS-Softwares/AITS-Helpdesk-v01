@model Ticket
@{ ViewData["Title"] = "Confirm deletion"; }
<div class="page-heading"><div><a asp-action="Index">← Back</a><h1>Confirm deletion</h1></div></div>
<section class="panel detail-panel"><h2>Delete @Model.Title?</h2><p>Deleting this ticket also removes its comments.</p><form asp-action="Delete" method="post"><input asp-for="Id" type="hidden" /><div class="form-actions"><button type="submit" class="button danger action-control"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2m3 0-1 14H6L5 6m4 4v6m6-6v6"/></svg><span>Delete permanently</span></button><a asp-action="Index">Cancel</a></div></form></section>
