@model TicketListViewModel
@{ ViewData["Title"] = "Tickets"; }
<div class="page-heading"><div><p class="eyebrow">SUPPORT QUEUE</p><h1>Tickets <span class="count">@Model.Tickets.Count</span></h1><p class="muted">@(User.IsInRole("AitsUser") ? "Showing tickets for your assigned company projects." : "Every request has a place. Every issue has a next step.")</p></div>@if (!User.IsInRole("AitsUser")) { <a class="button" asp-action="Create">+ New ticket</a> }</div>
<section class="panel"><form method="get" class="filters"><input asp-for="Search" placeholder="Search by title, description or ticket ID" aria-label="Search tickets" /><select asp-for="Status" asp-items="Html.GetEnumSelectList<TicketStatus>()"><option value="">All statuses</option></select><select asp-for="Priority" class="priority-select" asp-items="Html.GetEnumSelectList<TicketPriority>()"><option value="">All priorities</option></select><select name="scope" id="scope" aria-label="Company or project"><option value="">All companies / projects</option>@foreach (var company in Model.Clients) {
<optgroup label="@company.Name"><option value="company:@company.Id" selected="@((string?)ViewBag.Scope == $"company:{company.Id}")">@company.Name / All projects</option>
@foreach (var project in Model.Projects.Where(p => p.ClientId == company.Id)) { <option value="project:@project.Id" selected="@((string?)ViewBag.Scope == $"project:{project.Id}")">@company.Name / @project.Name</option> }</optgroup>
}</select><button class="button" type="submit">Filter</button><a asp-action="Index">Reset</a></form><div class="table-scroll"><table><thead><tr><th>Ticket</th><th>Company</th><th>Project</th><th>Status</th><th>Priority</th><th>Level</th><th>Assigned to</th><th>Resolution TAT</th><th>Updated (UTC)</th></tr></thead><tbody>@foreach (var ticket in Model.Tickets) { <tr><td><a class="table-ticket" asp-action="Details" asp-route-id="@ticket.Id"><small>#@ticket.Id.ToString("D4")</small><strong>@ticket.Title</strong></a></td><td>@Model.Clients.Find(c => c.Id == ticket.ClientId)?.Name</td><td>@(ticket.Project?.Name ?? "No project")</td><td><span class="badge @ticket.Status">@ticket.Status</span></td><td><span class="priority @ticket.Priority">● @ticket.Priority</span></td><td>@ticket.SupportLevel</td><td>@(Model.Users.Find(u => u.Id == ticket.AssigneeId)?.Name ?? "Unassigned")</td><td><partial name="_TatDeadline" model="ticket" /></td><td class="muted">@ticket.UpdatedAt.ToString("dd MMM yyyy, HH:mm")</td></tr> }</tbody></table></div>@if (!Model.Tickets.Any()) { <div class="empty">No tickets match your filters.</div> }</section>
@section Scripts {
<script>
    const priorityFilter = document.getElementById('Priority');
    function updatePriorityColor() { priorityFilter.dataset.priority = priorityFilter.value; }
    priorityFilter.addEventListener('change', updatePriorityColor);
    updatePriorityColor();
</script>
}

