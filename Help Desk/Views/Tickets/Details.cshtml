@model Ticket
@{ var memberships = (List<StaffProject>)ViewBag.StaffMemberships; var currentStaffId = int.TryParse(User.FindFirst("desk_user_id")?.Value, out var parsedStaffId) ? parsedStaffId : -1; ViewData["Title"] = $"Ticket #{Model.Id:D4}"; var users = (List<DeskUser>)ViewBag.Users; var attachments = (List<TicketAttachmentInfo>)ViewBag.Attachments; var inlineAttachments = attachments.Where(a => a.FileName.StartsWith("inline-", StringComparison.OrdinalIgnoreCase) && a.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase)).ToList(); var descriptionInlineAttachments = inlineAttachments.Where(a => a.CommentId is null).ToList(); var fileAttachments = attachments.Except(inlineAttachments).ToList(); var displayDescription = System.Text.RegularExpressions.Regex.Replace(Model.Description, @"[ \t]*\r?\n[ \t]*", "\n"); displayDescription = System.Text.RegularExpressions.Regex.Replace(displayDescription, @"\n{3,}", "\n\n"); }
<div class="ticket-details-page">
<div class="page-heading"><div><a asp-action="Index">← Back to tickets</a><p class="eyebrow">TICKET #@Model.Id.ToString("D4")</p><h1>@Model.Title</h1><p class="muted">Created @Help_Desk.Services.TicketTiming.ToIndiaTime(Model.CreatedAt).ToString("dd MMM yyyy, hh:mm tt") IST</p></div>@if (User.IsInRole("Admin")) { <a class="button action-control" asp-action="Edit" asp-route-id="@Model.Id"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg><span>Edit ticket</span></a> }@if (User.IsInRole("Admin")) { <form asp-action="Delete" method="post" class="inline-delete-form" data-confirm-delete data-confirm-title="Delete ticket?" data-confirm-message="Delete @Model.Title? This also deletes its comments and cannot be undone."><input type="hidden" name="id" value="@Model.Id" /><button class="button button-secondary action-control action-control--delete" type="submit"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2m3 0-1 14H6L5 6m4 4v6m6-6v6"/></svg><span>Delete ticket</span></button></form> }</div>@{ var dueAt = Help_Desk.Services.TicketTiming.DueAt(Model); var finished = Model.ClosedAt; var clock = finished ?? DateTime.UtcNow; var missed = clock > dueAt; }

<div class="ticket-top-grid"><section class="panel detail-panel ticket-meta"><h2>Ticket details</h2><dl class="ticket-meta-grid"><div><dt>Customer</dt><dd>@(((List<Client>)ViewBag.Clients).Find(c => c.Id == Model.ClientId)?.Name)</dd></div><div><dt>Status</dt><dd><span class="badge @Model.Status">@Model.Status</span></dd></div><div><dt>Support level</dt><dd><span class="badge">@Model.SupportLevel</span></dd></div><div><dt>Priority</dt><dd><span class="priority @Model.Priority">● @Model.Priority</span></dd></div><div><dt>Requester</dt><dd>@(users.Find(u => u.Id == Model.RequesterId)?.Name)</dd></div><div><dt>Current work owner</dt><dd>@(users.Find(u => u.Id == Model.AssigneeId)?.Name ?? "Unassigned")<small class="ticket-owner-note">One agent owns this ticket at a time.</small></dd></div><div><dt>Elapsed time</dt><dd>@Help_Desk.Services.TicketTiming.Duration((Model.ClosedAt ?? DateTime.UtcNow) - Model.CreatedAt)</dd></div><div><dt>Last updated (IST)</dt><dd>@Help_Desk.Services.TicketTiming.ToIndiaTime(Model.UpdatedAt).ToString("dd MMM yyyy, hh:mm tt")</dd></div></dl>@if (User.IsInRole("Admin") && Model.Status != TicketStatus.Resolved && Model.Status != TicketStatus.Closed) { var assignableStaff = (List<AitsStaffUser>)ViewBag.AssignableStaff;<form asp-action="Assign" method="post" class="ticket-assign-form ticket-route-form"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="returnToDetails" value="true" /><label for="ticketRouteTarget">Escalate Tickets</label><select id="ticketRouteTarget" name="assigneeId"><option value="">Select agent</option>@foreach (var agent in assignableStaff) { var agentLevel = memberships.FirstOrDefault(m => m.StaffId == agent.Id && m.ProjectId == Model.ProjectId)?.SupportLevel; <option value="@agent.Id" selected="@(Model.AssigneeId == agent.Id)">@agent.Name (@agentLevel)</option> }</select><button class="button" type="submit">Assign</button></form>}@if (User.IsInRole("Admin")) { <form asp-action="SetStatus" method="post" class="ticket-status-form" data-auto-submit><input type="hidden" name="id" value="@Model.Id" /><label for="ticketStatus">Update status</label><select id="ticketStatus" name="status">@foreach (var value in Enum.GetValues<TicketStatus>()) { <option value="@value" selected="@(Model.Status == value)">@value</option> }</select></form> }</section></div><div class="ticket-content-grid"><section class="panel detail-panel"><h2>Description</h2><div class="preserve ticket-description-text">@displayDescription</div>@foreach (var inlineImage in descriptionInlineAttachments) { <a class="ticket-inline-image" asp-action="AttachmentPreview" asp-route-id="@inlineImage.Id" target="_blank" rel="noopener"><img src="@Url.Action("AttachmentPreview", new { id = inlineImage.Id })" alt="Screenshot included in the email" loading="lazy" /></a> }</section>@if (fileAttachments.Count > 0) { <section class="panel detail-panel"><h2>Attachments <span class="count">@fileAttachments.Count</span></h2><div class="ticket-attachment-previews">@foreach (var attachment in fileAttachments.Where(a => a.ContentType == "image/jpeg" || a.ContentType == "image/png" || a.ContentType == "image/gif" || a.ContentType == "image/webp")) { <a asp-action="AttachmentPreview" asp-route-id="@attachment.Id" target="_blank" rel="noopener"><img src="@Url.Action("AttachmentPreview", new { id = attachment.Id })" alt="@attachment.FileName" loading="lazy" /></a> }</div><div class="ticket-attachment-list">@foreach (var attachment in fileAttachments) { <div class="ticket-attachment"><span class="ticket-attachment-icon" aria-hidden="true">↧</span><span class="ticket-attachment-name">@attachment.FileName<small>@attachment.ContentType · @Help_Desk.Services.TicketTiming.ToIndiaTime(attachment.UploadedAt).ToString("dd MMM yyyy, hh:mm tt") IST</small></span>@if (attachment.ContentType == "application/pdf") { <a class="ticket-attachment-open" asp-action="AttachmentPreview" asp-route-id="@attachment.Id" target="_blank" rel="noopener">Preview</a> }<a class="ticket-attachment-download" asp-action="Attachment" asp-route-id="@attachment.Id">Download</a></div> }</div></section> } else { <section class="panel detail-panel"><h2>Attachments</h2><p class="muted">No attachments.</p></section> }</div>
<div class="overview-grid"><div>@if (ViewBag.HasPhoto == true) { <section class="panel detail-panel ticket-photo-detail"><h2>Attached photo</h2><a asp-action="Photo" asp-route-id="@Model.Id" target="_blank" rel="noopener"><img src="@Url.Action("Photo", new { id = Model.Id })" alt="Photo attached to ticket #@Model.Id" loading="lazy" /></a><a asp-action="Photo" asp-route-id="@Model.Id" target="_blank" rel="noopener">Open full photo ↗</a></section> }<section class="panel detail-panel ticket-conversation"><h2>Conversation <span class="count">@Model.Comments.Count</span></h2><div class="ticket-message-list">@foreach (var comment in Model.Comments) { <article class="comment @(comment.AuthorRole == "Customer user" ? "comment-customer" : "comment-agent")"><small class="muted">@(comment.AuthorName ?? "Workspace note") @(comment.AuthorRole is null ? "" : "· " + comment.AuthorRole) · @Help_Desk.Services.TicketTiming.ToIndiaTime(comment.CreatedAt).ToString("dd MMM yyyy, hh:mm tt") IST</small><p class="preserve">@comment.Body</p>@foreach (var replyImage in attachments.Where(a => a.CommentId == comment.Id && a.FileName.StartsWith("inline-", StringComparison.OrdinalIgnoreCase) && a.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))) { <a class="ticket-inline-image" asp-action="AttachmentPreview" asp-route-id="@replyImage.Id" target="_blank" rel="noopener"><img src="@Url.Action("AttachmentPreview", new { id = replyImage.Id })" alt="Screenshot in reply" loading="lazy" /></a> }@foreach (var replyFile in attachments.Where(a => a.CommentId == comment.Id && !(a.FileName.StartsWith("inline-", StringComparison.OrdinalIgnoreCase) && a.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase)))) { <a class="ticket-reply-file" asp-action="Attachment" asp-route-id="@replyFile.Id"><span aria-hidden="true">↧</span><span>@replyFile.FileName<small>@replyFile.ContentType</small></span></a> }</article> }</div>@if (!Model.Comments.Any()) { <p class="muted">No updates yet. Add a note to keep everyone informed.</p> }<form asp-action="Comment" method="post" enctype="multipart/form-data"><input name="id" value="@Model.Id" type="hidden" /><label for="body">Reply to customer</label><textarea id="body" name="body" rows="1" maxlength="3000" class="ticket-reply-input" data-auto-grow placeholder="Write your reply…"></textarea><div class="ticket-reply-attachments"><label for="replyFiles">Attach files</label><input id="replyFiles" name="files" type="file" multiple /><small class="muted">Up to 10 files · 10 MB each · 25 MB total</small></div><button class="button" type="submit">Send reply</button></form></section>@if (User.IsInRole("Admin")) {
    var notifications = (List<TicketEmailNotification>)ViewBag.EmailNotifications;
    <section class="panel detail-panel"><h2>Ticket email notifications <span class="count">@notifications.Count</span></h2>
    @if (notifications.Any()) {
        <div class="table-scroll"><table><thead><tr><th>Recipient</th><th>Notification</th><th>Delivery</th><th>Attempts</th><th></th></tr></thead><tbody>
        @foreach (var notification in notifications) { <tr><td>@notification.RecipientEmail</td><td>@(notification.Kind == TicketEmailKind.TatOverdue ? "TAT overdue" : "New ticket")</td><td><span class="badge email-@notification.Status">@notification.Status</span>@if (notification.LastError is not null) { <small class="email-delivery-note">@notification.LastError</small> }</td><td>@notification.Attempts</td><td>@if (notification.Status == TicketEmailStatus.Failed) { <form asp-action="RetryEmail" method="post"><input type="hidden" name="id" value="@notification.Id" /><button type="submit" class="text-button">Retry email</button></form> }</td></tr> }
        </tbody></table></div>
    } else { <p class="muted">No ticket-created emails were queued. Notifications go to active, approved agents assigned to the ticket's customer when it is created.</p> }
    </section>
}
</div></div>
@if (User.IsInRole("AitsUser")) {
    <section class="panel detail-panel" id="ticket-actions" style="margin-bottom:14px"><h2>Ticket status</h2><form asp-action="WorkStatus" method="post" class="ticket-work-status-form" data-auto-submit><input type="hidden" name="id" value="@Model.Id" /><label for="agentTicketStatus">Update status</label><select id="agentTicketStatus" name="status">@foreach (var status in Enum.GetValues<TicketStatus>()) { <option value="@((int)status)" selected="@(Model.Status == status)">@(status == TicketStatus.InProgress ? "In Progress" : status.ToString())</option> }</select></form></section>
}
@if (User.IsInRole("AitsUser") || User.IsInRole("Admin")) {
<section class="panel detail-panel"><h2>Escalation</h2>
@foreach (var entry in (List<TicketEscalation>)ViewBag.Escalations) { <article class="comment"><strong>@entry.FromLevel → @entry.ToLevel</strong><small class="muted"> · @entry.Staff?.Name · @Help_Desk.Services.TicketTiming.ToIndiaTime(entry.CreatedAt).ToString("dd MMM yyyy hh:mm tt") IST</small><p>@entry.Reason</p></article> }
</section>
}
<section class="panel detail-panel ticket-progress"><div class="panel-heading"><div><h2>Resolution progress &amp; TAT</h2></div><span class="badge @(missed ? "tat-overdue" : "status-active")">@(finished.HasValue ? missed ? "Resolved after target" : "Resolved within target" : missed ? "Overdue" : "Within target")</span></div>
<div class="tat-detail-summary"><partial name="_TatDeadline" model="Model" /></div><div class="stats"><div class="stat"><span>Resolution target</span><strong>@((dueAt - Model.CreatedAt).TotalHours.ToString("0.#"))h</strong><small>Target for this ticket · @Model.Priority priority</small></div><div class="stat"><span>@(finished.HasValue ? "Actual resolution time" : "Time since creation")</span><strong class="time-value">@Help_Desk.Services.TicketTiming.Duration(clock - Model.CreatedAt)</strong></div><div class="stat"><span>@(finished.HasValue ? missed ? "Target exceeded by" : "Ahead of target by" : missed ? "Overdue by" : "Time remaining")</span><strong class="time-value">@Help_Desk.Services.TicketTiming.Duration(missed ? clock - dueAt : dueAt - clock)</strong></div></div>
<div class="form-grid"><div><label>Ticket created (IST)</label><p>@Help_Desk.Services.TicketTiming.ToIndiaTime(Model.CreatedAt).ToString("dd MMM yyyy, hh:mm tt")</p><label>Resolution deadline (IST)</label><p>@Help_Desk.Services.TicketTiming.ToIndiaTime(dueAt).ToString("dd MMM yyyy, hh:mm tt")</p><label>Assigned agent</label><p>@(users.Find(u => u.Id == Model.AssigneeId)?.Name ?? "Waiting for agent assignment")</p><label>Current team</label><p>@Model.SupportLevel</p></div><div><label>Work started (IST)</label><p>@(Model.WorkStartedAt.HasValue ? Help_Desk.Services.TicketTiming.ToIndiaTime(Model.WorkStartedAt.Value).ToString("dd MMM yyyy, hh:mm tt") : (Model.Status == TicketStatus.Open ? "Not started yet" : "No start time recorded"))</p><label>Resolved / closed (IST)</label><p>@(finished.HasValue ? Help_Desk.Services.TicketTiming.ToIndiaTime(finished.Value).ToString("dd MMM yyyy, hh:mm tt") : "Not resolved yet")</p><label>Time since work started</label><p>@(Model.WorkStartedAt.HasValue ? Help_Desk.Services.TicketTiming.Duration(clock - Model.WorkStartedAt.Value) : "Not started yet")</p><small class="muted">Elapsed time since starting, not measured agent labor hours.</small></div></div>

</section>
</div>
