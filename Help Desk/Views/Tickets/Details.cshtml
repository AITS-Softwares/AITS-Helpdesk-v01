@model Ticket
@{ var memberships = (List<StaffProject>)ViewBag.StaffMemberships; var currentStaffId = int.TryParse(User.FindFirst("desk_user_id")?.Value, out var parsedStaffId) ? parsedStaffId : -1; ViewData["Title"] = $"Ticket #{Model.Id:D4}"; var users = (List<DeskUser>)ViewBag.Users; }
<div class="page-heading"><div><a asp-action="Index">← Back to tickets</a><p class="eyebrow">TICKET #@Model.Id.ToString("D4")</p><h1>@Model.Title</h1><p class="muted">Created @Model.CreatedAt.ToString("dd MMM yyyy, HH:mm") UTC</p></div>@if (User.IsInRole("Admin")) { <a class="button" asp-action="Edit" asp-route-id="@Model.Id">Edit ticket</a> }@if (User.IsInRole("Admin")) { <a asp-action="Delete" asp-route-id="@Model.Id">Delete ticket</a> }</div>@if (User.IsInRole("AitsUser")) {
    var open = Model.Status != TicketStatus.Closed && Model.Status != TicketStatus.Resolved;
    var owner = users.Find(u => u.Id == Model.AssigneeId)?.Name ?? "Unassigned";
    var myLevel = memberships.FirstOrDefault(m => m.StaffId == currentStaffId && m.ProjectId == Model.ProjectId)?.SupportLevel;
    <section class="panel detail-panel" id="ticket-actions" style="margin-bottom:24px"><h2>Ticket assignment</h2>
    <p>Current team: <strong>@Model.SupportLevel</strong> · Assigned to: <strong>@owner</strong> · Your project team: <strong>@myLevel</strong></p>
    @if (!open) { <p class="muted">This ticket is resolved or closed. Assignment actions are unavailable.</p> }
    else {
        @if (Model.AssigneeId == currentStaffId) { <p class="notice">You own this ticket.</p> }
        else if (Model.AssigneeId.HasValue) { <p class="muted">@owner is handling this ticket. Only its owner can escalate it. Contact Admin for reassignment.</p> }
        else if (myLevel == Model.SupportLevel) {
            <form asp-action="Claim" method="post"><input type="hidden" name="id" value="@Model.Id" /><button type="submit" class="button">Take ownership / Assign to me</button></form>
        } else {
            <button type="button" class="button" disabled>Take ownership / Assign to me</button><p class="muted">Only the @Model.SupportLevel team can take ownership. Your project team is @myLevel. Admin manages team membership under Companies → company → project.</p>
        }
        @if (Model.AssigneeId == currentStaffId) {
            <form asp-action="WorkStatus" method="post"><input type="hidden" name="id" value="@Model.Id" />
            @if (Model.Status == TicketStatus.Open) { <button name="status" value="1" class="button" type="submit">Start work</button> }
            @if (Model.Status == TicketStatus.InProgress) { <button name="status" value="2" class="button button-secondary" type="submit">Mark resolved</button> }</form>
        }
        @if ((!Model.AssigneeId.HasValue || Model.AssigneeId == currentStaffId) && Model.SupportLevel != SupportLevel.L3) {
            <form asp-action="Escalate" method="post"><input type="hidden" name="id" value="@Model.Id" /><label for="escalationLevel">Assign / escalate to team</label><select id="escalationLevel" name="level">@foreach (var level in Enum.GetValues<SupportLevel>().Where(l => l > Model.SupportLevel)) { <option value="@((int)level)">@level team</option> }</select><label for="escalationReason">Reason</label><textarea id="escalationReason" name="reason" required maxlength="1000"></textarea><button class="button" type="submit">Assign / Escalate ticket</button></form>
        }
        else if (Model.SupportLevel == SupportLevel.L3) { <p class="muted">This ticket is already at L3, the highest support level.</p> }
    }
    </section>
}@{ var dueAt = Help_Desk.Services.TicketTiming.DueAt(Model); var finished = Model.ClosedAt; var clock = finished ?? DateTime.UtcNow; var missed = clock > dueAt; }
<section class="panel detail-panel ticket-progress"><div class="panel-heading"><div><h2>Resolution progress &amp; TAT</h2><p class="muted">Calendar-hour target from ticket creation. All timestamps are UTC.</p></div><span class="badge @(missed ? "tat-overdue" : "status-active")">@(finished.HasValue ? missed ? "Resolved after target" : "Resolved within target" : missed ? "Overdue" : "Within target")</span></div>
<div class="tat-detail-summary"><partial name="_TatDeadline" model="Model" /></div><div class="stats"><div class="stat"><span>Resolution target</span><strong>@((dueAt - Model.CreatedAt).TotalHours.ToString("0.#"))h</strong><small>Target for this ticket · @Model.Priority priority</small></div><div class="stat"><span>@(finished.HasValue ? "Actual resolution time" : "Time since creation")</span><strong class="time-value">@Help_Desk.Services.TicketTiming.Duration(clock - Model.CreatedAt)</strong></div><div class="stat"><span>@(finished.HasValue ? missed ? "Target exceeded by" : "Ahead of target by" : missed ? "Overdue by" : "Time remaining")</span><strong class="time-value">@Help_Desk.Services.TicketTiming.Duration(missed ? clock - dueAt : dueAt - clock)</strong></div></div>
<div class="form-grid"><div><label>Resolution deadline (UTC)</label><p>@dueAt.ToString("dd MMM yyyy, HH:mm")</p><label>Assigned staff</label><p>@(users.Find(u => u.Id == Model.AssigneeId)?.Name ?? "Waiting for staff assignment")</p><label>Current team</label><p>@Model.SupportLevel</p></div><div><label>Work started (UTC)</label><p>@(Model.WorkStartedAt?.ToString("dd MMM yyyy, HH:mm") ?? (Model.Status == TicketStatus.Open ? "Not started yet" : "No start time recorded"))</p><label>Resolved / closed (UTC)</label><p>@(finished?.ToString("dd MMM yyyy, HH:mm") ?? "Not resolved yet")</p><label>Time since work started</label><p>@(Model.WorkStartedAt.HasValue ? Help_Desk.Services.TicketTiming.Duration(clock - Model.WorkStartedAt.Value) : "Not started yet")</p><small class="muted">Elapsed time since starting, not measured staff labor hours.</small></div></div>
<h2>Progress history</h2><article class="comment"><strong>Ticket created</strong><small class="muted"> · @Model.CreatedAt.ToString("dd MMM yyyy, HH:mm") UTC</small></article>
@foreach (var activity in (List<TicketActivity>)ViewBag.Activities) { <article class="comment"><strong>@activity.ActorName</strong><small class="muted"> · @activity.CreatedAt.ToString("dd MMM yyyy, HH:mm") UTC</small><p>@activity.Message</p></article> }
</section>

<div class="overview-grid"><div><section class="panel detail-panel"><h2>Description</h2><p class="preserve">@Model.Description</p></section>@if (ViewBag.HasPhoto == true) { <section class="panel detail-panel ticket-photo-detail"><h2>Attached photo</h2><a asp-action="Photo" asp-route-id="@Model.Id" target="_blank" rel="noopener"><img src="@Url.Action("Photo", new { id = Model.Id })" alt="Photo attached to ticket #@Model.Id" loading="lazy" /></a><a asp-action="Photo" asp-route-id="@Model.Id" target="_blank" rel="noopener">Open full photo ↗</a></section> }<section class="panel detail-panel"><h2>Conversation <span class="count">@Model.Comments.Count</span></h2>@foreach (var comment in Model.Comments) { <article class="comment"><small class="muted">@(comment.AuthorName ?? "Workspace note") @(comment.AuthorRole is null ? "" : "· " + comment.AuthorRole) · @comment.CreatedAt.ToString("dd MMM yyyy, HH:mm") UTC</small><p class="preserve">@comment.Body</p></article> }@if (!Model.Comments.Any()) { <p class="muted">No updates yet. Add a note to keep everyone informed.</p> }<form asp-action="Comment" method="post"><input name="id" value="@Model.Id" type="hidden" /><label for="body">Add a note</label><textarea id="body" name="body" rows="4" maxlength="3000" required placeholder="Share an update…"></textarea><button class="button" type="submit">Add comment</button></form></section>@if (User.IsInRole("Admin")) {
    var notifications = (List<TicketEmailNotification>)ViewBag.EmailNotifications;
    <section class="panel detail-panel"><h2>Ticket email notifications <span class="count">@notifications.Count</span></h2>
    @if (notifications.Any()) {
        <div class="table-scroll"><table><thead><tr><th>Recipient</th><th>Notification</th><th>Delivery</th><th>Attempts</th><th></th></tr></thead><tbody>
        @foreach (var notification in notifications) { <tr><td>@notification.RecipientEmail</td><td>@(notification.Kind == TicketEmailKind.TatOverdue ? "TAT overdue" : "New ticket")</td><td><span class="badge email-@notification.Status">@notification.Status</span>@if (notification.LastError is not null) { <small class="email-delivery-note">@notification.LastError</small> }</td><td>@notification.Attempts</td><td>@if (notification.Status == TicketEmailStatus.Failed) { <form asp-action="RetryEmail" method="post"><input type="hidden" name="id" value="@notification.Id" /><button type="submit" class="text-button">Retry email</button></form> }</td></tr> }
        </tbody></table></div>
    } else { <p class="muted">No ticket-created emails were queued. Notifications go to active, approved staff assigned to the ticket's project when it is created.</p> }
    </section>
}
</div><section class="panel detail-panel metadata"><h2>Ticket details</h2><label>Company</label><span>@(((List<Client>)ViewBag.Clients).Find(c => c.Id == Model.ClientId)?.Name)</span><label>Project</label><span>@(((List<CompanyProject>)ViewBag.Projects).Find(p => p.Id == Model.ProjectId)?.Name ?? "No project")</span><label>Status</label><span class="badge @Model.Status">@Model.Status</span><label>Support level</label><span class="badge">@Model.SupportLevel</span><label>Priority</label><span class="priority @Model.Priority">● @Model.Priority</span><label>Requester</label><span>@(users.Find(u => u.Id == Model.RequesterId)?.Name)</span><label>Assigned to</label><span>@(users.Find(u => u.Id == Model.AssigneeId)?.Name ?? "Unassigned")</span>
<label>Elapsed time since creation</label>@{ var elapsed = (Model.ClosedAt ?? DateTime.UtcNow) - Model.CreatedAt; }<span>@((int)Math.Max(0, elapsed.TotalDays))d @elapsed.Hours.ToString("D2")h @elapsed.Minutes.ToString("D2")m</span><small class="muted">@(Model.ClosedAt.HasValue ? "Time from creation until resolution/closure." : "Calendar time since creation; not staff hours worked.")</small><label>Last updated (UTC)</label><span>@Model.UpdatedAt.ToString("dd MMM yyyy, HH:mm")</span></section></div>
@if (User.IsInRole("AitsUser") || User.IsInRole("Admin")) {
<section class="panel detail-panel"><h2>Escalation</h2>
@foreach (var entry in (List<TicketEscalation>)ViewBag.Escalations) { <article class="comment"><strong>@entry.FromLevel → @entry.ToLevel</strong><small class="muted"> · @entry.Staff?.Name · @entry.CreatedAt.ToString("dd MMM yyyy HH:mm") UTC</small><p>@entry.Reason</p></article> }
</section>
}



