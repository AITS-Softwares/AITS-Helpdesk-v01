@model Ticket
@{ ViewData["Title"] = $"Ticket #{Model.Id:D4}"; var users = (List<DeskUser>)ViewBag.Users; }
<div class="page-heading"><div><a asp-action="Index">← Back to tickets</a><p class="eyebrow">TICKET #@Model.Id.ToString("D4")</p><h1>@Model.Title</h1><p class="muted">Created @Model.CreatedAt.ToString("dd MMM yyyy, HH:mm") UTC</p></div><a class="button" asp-action="Edit" asp-route-id="@Model.Id">Edit ticket</a>@if (User.IsInRole("Admin") || User.IsInRole("AitsUser")) { <a asp-action="Delete" asp-route-id="@Model.Id">Delete ticket</a> }</div><div class="overview-grid"><div><section class="panel detail-panel"><h2>Description</h2><p class="preserve">@Model.Description</p></section><section class="panel detail-panel"><h2>Conversation <span class="count">@Model.Comments.Count</span></h2>@foreach (var comment in Model.Comments) { <article class="comment"><small class="muted">Workspace note · @comment.CreatedAt.ToString("dd MMM yyyy, HH:mm") UTC</small><p class="preserve">@comment.Body</p></article> }@if (!Model.Comments.Any()) { <p class="muted">No updates yet. Add a note to keep everyone informed.</p> }<form asp-action="Comment" method="post"><input name="id" value="@Model.Id" type="hidden" /><label for="body">Add a note</label><textarea id="body" name="body" rows="4" maxlength="3000" required placeholder="Share an update…"></textarea><button class="button" type="submit">Add comment</button></form></section></div><section class="panel detail-panel metadata"><h2>Ticket details</h2><label>Company</label><span>@(((List<Client>)ViewBag.Clients).Find(c => c.Id == Model.ClientId)?.Name)</span><label>Status</label><span class="badge @Model.Status">@Model.Status</span><label>Priority</label><span class="priority @Model.Priority">● @Model.Priority</span><label>Requester</label><span>@(users.Find(u => u.Id == Model.RequesterId)?.Name)</span><label>Assigned to</label><span>@(users.Find(u => u.Id == Model.AssigneeId)?.Name ?? "Unassigned")</span><label>Last updated (UTC)</label><span>@Model.UpdatedAt.ToString("dd MMM yyyy, HH:mm")</span></section></div>